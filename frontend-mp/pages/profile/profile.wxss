.page-profile {
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 用户卡片 */
.user-card {
  background: linear-gradient(135deg, #6B4226 0%, #8b5e3c 100%);
  padding: 60rpx 32rpx 48rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.3);
}

.avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255,255,255,0.8);
}

.avatar-placeholder .icon {
  transform: scale(1.8);
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
}

.user-id {
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
  margin-top: 8rpx;
}

.login-btn {
  padding: 16rpx 32rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 32rpx;
  color: #fff;
  font-size: 26rpx;
}

/* 菜单 */
.menu-card {
  margin: 24rpx;
  padding: 0;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
}

.menu-item:active {
  background: #f9f6f3;
}

.menu-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6B4226;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.menu-value {
  font-size: 26rpx;
  color: #999;
  margin-right: 8rpx;
}

.menu-arrow {
  width: 24rpx;
  height: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ccc;
}

.menu-divider {
  height: 1rpx;
  background: #f0f0f0;
  margin-left: 80rpx;
}

/* 主题弹窗 */
.theme-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 300;
}

.theme-panel {
  position: fixed;
  bottom: -400rpx;
  left: 0; right: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 301;
  transition: bottom 0.3s ease;
}

.theme-panel.show { bottom: 0; }

.theme-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 36rpx;
}

.theme-options {
  display: flex;
  justify-content: space-around;
}

.theme-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: #666;
}

.theme-option.selected {
  color: #6B4226;
  font-weight: 600;
}

.theme-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.theme-option.selected .theme-circle {
  box-shadow: 0 0 0 4rpx #6B4226;
}

/* 头像昵称授权面板 */
.avatar-panel {
  position: fixed;
  bottom: -600rpx;
  left: 0; right: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 301;
  transition: bottom 0.3s ease;
}

.avatar-panel.show { bottom: 0; }

.panel-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  text-align: center;
  margin-bottom: 40rpx;
}

.avatar-section {
  display: flex;
  justify-content: center;
  margin-bottom: 40rpx;
}

.avatar-btn {
  width: 160rpx;
  height: 160rpx;
  padding: 0;
  background: transparent;
  border: none;
  line-height: normal;
}

.avatar-btn::after {
  border: none;
}

.avatar-preview {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid #6B4226;
}

.avatar-placeholder-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #f5f5f5;
  border: 2rpx dashed #ccc;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 22rpx;
}

.avatar-placeholder-btn .icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.nickname-section {
  margin-bottom: 40rpx;
}

.nickname-label {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 16rpx;
}

.nickname-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.save-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #6B4226 0%, #8b5e3c 100%);
  color: #fff;
  font-size: 30rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.save-btn::after {
  border: none;
}

.user-tip {
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
  margin-top: 4rpx;
}

/* 退出登录 */
.logout-item:active {
  background: #fff5f0;
}
