.edit-page {
  min-height: 100vh;
  background: #F7F7FA;
  padding: 24rpx;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  padding-top: 200rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #E8E8E8;
  border-top-color: #4A90D9;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.form-section {
  background: #FFF;
  border-radius: 16rpx;
  overflow: hidden;
}

.form-item {
  padding: 32rpx;
  border-bottom: 1rpx solid #F0F0F3;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.required {
  color: #F56C6C;
  margin-left: 4rpx;
}

.form-input {
  width: 100%;
  height: 72rpx;
  background: #F7F7FA;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.form-picker {
  height: 72rpx;
  background: #F7F7FA;
  border-radius: 12rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-tag {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  color: #FFF;
  font-size: 24rpx;
}

.picker-placeholder {
  font-size: 28rpx;
  color: #999;
}

.picker-arrow {
  font-size: 36rpx;
  color: #CCC;
}

.save-wrap {
  margin-top: 60rpx;
  padding: 0 24rpx;
}

.btn-save {
  width: 100%;
  height: 92rpx;
  background: linear-gradient(135deg, #4A90D9, #50E3C2);
  border-radius: 46rpx;
  color: #FFF;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 92rpx;
  border: none;
}

.btn-save.disabled {
  opacity: 0.6;
}

.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 99;
}

.picker-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFF;
  z-index: 100;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}

.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #F0F0F3;
  flex-shrink: 0;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.picker-close {
  font-size: 32rpx;
  color: #999;
  padding: 10rpx;
}

.picker-list {
  flex: 1;
  overflow-y: auto;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.picker-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  gap: 20rpx;
}

.picker-item.selected {
  background: #F5F8FF;
}

.item-color {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.item-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.item-check {
  color: #4A90D9;
  font-size: 30rpx;
  font-weight: bold;
}
