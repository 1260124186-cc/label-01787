.page-notes {
  min-height: 100vh;
  padding-bottom: 120rpx;
  background: #F7F3EE;
}

.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 20rpx;
  background: #fff;
}

.page-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.export-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #6B4226;
  padding: 10rpx 20rpx;
  background: #F5F0EB;
  border-radius: 30rpx;
}

.filter-section {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  gap: 16rpx;
  border-top: 1rpx solid #F0ECE6;
}

.type-tabs {
  flex: 1;
  white-space: nowrap;
}

.type-tabs .tab {
  display: inline-block;
  padding: 12rpx 28rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  color: #666;
  background: #F5F0EB;
  margin-right: 16rpx;
}

.type-tabs .tab.active {
  background: #6B4226;
  color: #fff;
}

.tag-tab {
  min-width: 140rpx;
  text-align: center;
}

.book-select {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 20rpx;
  background: #F5F0EB;
  border-radius: 24rpx;
  flex-shrink: 0;
}

.book-label {
  font-size: 24rpx;
  color: #666;
}

.tag-dropdown {
  display: none;
  background: #fff;
  padding: 16rpx 24rpx;
  border-top: 1rpx solid #F0ECE6;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-dropdown.show {
  display: flex;
}

.tag-item {
  padding: 10rpx 24rpx;
  background: #F5F0EB;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #666;
}

.tag-item.active {
  background: #6B4226;
  color: #fff;
}

.empty-tag {
  width: 100%;
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 20rpx 0;
}

.export-menu {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 1001;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}

.export-menu.show {
  transform: translateY(0);
}

.menu-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #F0ECE6;
}

.menu-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.menu-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.book-list {
  flex: 1;
  max-height: 400rpx;
  padding: 16rpx 0;
}

.book-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
}

.book-item.selected {
  background: #F5F0EB;
}

.book-name {
  font-size: 28rpx;
  color: #333;
}

.empty-book {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 26rpx;
}

.menu-actions {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx 48rpx;
}

.menu-actions button {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  border-radius: 40rpx;
  border: none;
}

.btn-primary {
  background: #6B4226;
  color: #fff;
}

.btn-secondary {
  background: #F5F0EB;
  color: #6B4226;
}

.menu-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.menu-mask.show {
  opacity: 1;
  pointer-events: auto;
}

.note-list {
  padding: 24rpx;
}

.note-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
  border-left: 8rpx solid #FFD93D;
  position: relative;
}

.note-card.pinned {
  box-shadow: 0 4rpx 20rpx rgba(107, 66, 38, 0.15);
}

.note-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.note-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.note-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
  font-weight: 500;
}

.tag-comment {
  background: #FFF3E0;
  color: #E8734A;
}

.tag-note {
  background: #E8F5E9;
  color: #4CAF50;
}

.note-page {
  font-size: 24rpx;
  color: #999;
}

.pin-icon {
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #E8734A;
}

.note-actions-top {
  display: flex;
  gap: 20rpx;
}

.action-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
}

.action-icon .icon-pin.active {
  color: #E8734A;
}

.note-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.tag-chip {
  padding: 6rpx 16rpx;
  background: rgba(107, 66, 38, 0.1);
  color: #6B4226;
  font-size: 22rpx;
  border-radius: 20rpx;
}

.note-selected {
  background: rgba(255, 255, 255, 0.6);
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  color: #666;
  border-left: 6rpx solid #D4A574;
}

.quote-mark {
  color: #D4A574;
  font-size: 36rpx;
  font-weight: 700;
  margin-right: 4rpx;
}

.note-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
  margin-bottom: 16rpx;
}

.note-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.note-time {
  font-size: 22rpx;
  color: #bbb;
}

.note-actions {
  display: flex;
  gap: 24rpx;
}

.action-btn {
  font-size: 24rpx;
  color: #6B4226;
}

.action-btn.danger {
  color: #F56C6C;
}

.share-btn {
  color: #E8734A;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  color: #ccc;
}

.empty-icon-wrap .icon {
  transform: scale(2.5);
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #bbb;
}

#noteCanvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 600px;
  height: 1000px;
}
