<view class="page-notes">
  <view class="top-bar">
    <view class="page-title">我的笔记</view>
    <view class="export-btn" bindtap="toggleExportMenu">
      <view class="icon icon-export"></view>
      <text>导出</text>
    </view>
  </view>

  <view class="filter-section">
    <scroll-view scroll-x class="type-tabs">
      <view class="tab {{noteType === '' ? 'active' : ''}}" bindtap="setFilter" data-type="">全部</view>
      <view class="tab {{noteType === 1 ? 'active' : ''}}" bindtap="setFilter" data-type="1">评语</view>
      <view class="tab {{noteType === 2 ? 'active' : ''}}" bindtap="setFilter" data-type="2">笔记</view>
      <view class="tab tag-tab {{currentTag ? 'active' : ''}}" bindtap="toggleTagFilter">
        {{currentTag ? '#' + currentTag : '标签筛选'}}
      </view>
    </scroll-view>

    <view class="book-select" bindtap="toggleExportMenu">
      <text class="book-label">{{selectedBookId ? '已选书籍' : '选择书籍'}}</text>
      <view class="icon icon-arrow-down"></view>
    </view>
  </view>

  <view class="tag-dropdown {{showTagFilter ? 'show' : ''}}">
    <view class="tag-item {{!currentTag ? 'active' : ''}}" bindtap="selectTag" data-tag="">
      全部标签
    </view>
    <view class="tag-item {{item === currentTag ? 'active' : ''}}"
      wx:for="{{allTags}}" wx:key="*this"
      bindtap="selectTag" data-tag="{{item}}">
      #{{item}}
    </view>
    <view class="empty-tag" wx:if="{{allTags.length === 0}}">
      暂无标签，给笔记添加标签后可在此筛选
    </view>
  </view>

  <view class="export-menu {{showExportMenu ? 'show' : ''}}">
    <view class="menu-header">
      <text class="menu-title">选择书籍并导出</text>
      <view class="menu-close" bindtap="toggleExportMenu">
        <view class="icon icon-close"></view>
      </view>
    </view>
    <scroll-view scroll-y class="book-list">
      <view class="book-item {{selectedBookId === item.id ? 'selected' : ''}}"
        wx:for="{{books}}" wx:key="id"
        bindtap="selectBookForExport" data-id="{{item.id}}">
        <text class="book-name">{{item.title}}</text>
        <view class="icon icon-check" wx:if="{{selectedBookId === item.id}}"></view>
      </view>
      <view class="empty-book" wx:if="{{books.length === 0}}">
        暂无书籍
      </view>
    </scroll-view>
    <view class="menu-actions">
      <button class="btn-secondary" bindtap="exportMarkdown" disabled="{{!selectedBookId}}">
        导出 Markdown
      </button>
      <button class="btn-primary" bindtap="generateNoteImage" disabled="{{!selectedBookId || generatingImage}}">
        {{generatingImage ? '生成中...' : '生成长图'}}
      </button>
    </view>
  </view>
  <view class="menu-mask {{showExportMenu ? 'show' : ''}}" bindtap="toggleExportMenu"></view>

  <view class="note-list">
    <view class="note-card {{item.isPinned ? 'pinned' : ''}}"
      style="border-left: 8rpx solid {{item.colorInfo.border}}; background: {{item.colorInfo.bg}};"
      wx:for="{{notes}}" wx:key="id">
      <view class="note-header">
        <view class="note-left">
          <view class="note-tag {{item.type === 1 ? 'tag-comment' : 'tag-note'}}">
            {{item.type === 1 ? '评语' : '笔记'}}
          </view>
          <text class="note-page">第{{item.pageNum}}页</text>
          <view class="pin-icon" wx:if="{{item.isPinned}}">
            <view class="icon icon-pin"></view>
          </view>
        </view>
        <view class="note-actions-top">
          <view class="action-icon" bindtap="togglePin" data-id="{{item.id}}">
            <view class="icon icon-pin {{item.isPinned ? 'active' : ''}}"></view>
          </view>
          <view class="action-icon" bindtap="changeColor" data-id="{{item.id}}">
            <view class="icon icon-palette"></view>
          </view>
        </view>
      </view>

      <view class="note-tags" wx:if="{{item.tagList.length > 0}}">
        <text class="tag-chip" wx:for="{{item.tagList}}" wx:key="*this" wx:for-item="tag">
          #{{tag}}
        </text>
      </view>

      <view class="note-selected" wx:if="{{item.selectedText}}">
        <text class="quote-mark">"</text>
        <text>{{item.selectedText}}</text>
      </view>
      <view class="note-content">
        <text>{{item.content}}</text>
      </view>
      <view class="note-footer">
        <text class="note-time">{{item.createdAt}}</text>
        <view class="note-actions">
          <text class="action-btn share-btn" bindtap="shareExcerpt" data-id="{{item.id}}" data-index="{{index}}" wx:if="{{item.selectedText}}">分享书摘</text>
          <text class="action-btn" bindtap="editNote" data-id="{{item.id}}" data-index="{{index}}">编辑</text>
          <text class="action-btn danger" bindtap="deleteNote" data-id="{{item.id}}">删除</text>
        </view>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{notes.length === 0 && !loading}}">
    <view class="empty-icon-wrap">
      <view class="icon icon-note"></view>
    </view>
    <text class="empty-text">还没有笔记</text>
    <text class="empty-hint">在阅读时添加笔记吧</text>
  </view>

  <canvas type="2d" id="noteCanvas" style="position: fixed; left: -9999px; top: -9999px; width: 600px; height: 1000px;"></canvas>
</view>
