<view class="page-bookshelf">
  <view class="top-bar">
    <view class="search-bar">
      <view class="search-icon">🔍</view>
      <input class="search-input" placeholder="搜索书名或作者..." value="{{searchKeyword}}"
        bindinput="onSearchInput" bindfocus="onSearchFocus" bindblur="onSearchBlur" confirm-type="search" />
      <view class="search-clear" wx:if="{{searchKeyword}}" bindtap="onSearchClear">✕</view>
    </view>
    <view class="tool-bar">
      <view class="tool-btn {{batchMode ? 'tool-btn-active' : ''}}" bindtap="toggleBatchMode">
        <text class="tool-btn-text">{{batchMode ? '取消' : '多选'}}</text>
      </view>
      <view class="tool-btn" bindtap="toggleSortPicker">
        <text class="tool-btn-text">排序</text>
        <text class="tool-btn-arrow">▼</text>
      </view>
      <view class="tool-btn" bindtap="toggleViewMode">
        <text class="tool-btn-text">{{viewMode === 'grid' ? '列表' : '网格'}}</text>
      </view>
      <view class="tool-btn" bindtap="goTrash">
        <text class="tool-btn-text">回收站</text>
      </view>
    </view>
    <view class="sort-picker" wx:if="{{showSortPicker}}">
      <view class="sort-option {{sortBy === item.key ? 'sort-option-active' : ''}}"
        wx:for="{{sortOptions}}" wx:key="key" bindtap="selectSort" data-key="{{item.key}}">
        <text class="sort-option-text">{{item.label}}</text>
        <view class="sort-check" wx:if="{{sortBy === item.key}}">✓</view>
      </view>
    </view>
  </view>

  <view class="filter-bar">
    <scroll-view scroll-x class="category-scroll" enhanced show-scrollbar="{{false}}">
      <view class="category-chips">
        <view class="chip {{!currentCategory ? 'chip-active' : ''}}" bindtap="filterCategory" data-id="">
          <view class="chip-dot" style="background: #6B4226"></view>
          <text class="chip-text">全部</text>
        </view>
        <view class="chip {{currentCategory === item.id ? 'chip-active' : ''}}"
          wx:for="{{categories}}" wx:key="id" bindtap="filterCategory" data-id="{{item.id}}">
          <view class="chip-dot" style="background: {{item.color || '#6B4226'}}"></view>
          <text class="chip-text">{{item.name}}</text>
        </view>
        <view class="chip chip-manage" bindtap="goCategory">
          <text class="chip-text">+ 管理</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="continue-section" wx:if="{{continueList.length > 0 && !batchMode}}">
    <view class="section-header">
      <text class="section-title">继续阅读</text>
      <text class="section-more" bindtap="goReadingHistory">更多 ›</text>
    </view>
    <scroll-view scroll-x class="continue-scroll" enhanced show-scrollbar="{{false}}">
      <view class="continue-scroll-inner">
        <view class="continue-card" wx:for="{{continueList}}" wx:key="bookId" wx:for-index="idx"
          bindtap="openContinueBook" data-id="{{item.bookId}}" data-page="{{item.lastPage}}" data-chapter="{{item.lastChapter}}" data-format="{{item.bookFormat}}">
          <view class="continue-cover">
            <image wx:if="{{item.coverThumbnail && item.coverThumbnailUrl && !item.coverLoadFailed}}"
                   class="continue-cover-image"
                   src="{{item.coverThumbnailUrl}}"
                   mode="aspectFill"
                   lazy-load="true"
                   binderror="onContinueCoverError"
                   data-index="{{idx}}" />
            <view wx:else class="continue-cover-placeholder">
              <text class="continue-cover-title">{{item.bookTitle}}</text>
              <text class="continue-cover-author">{{item.bookAuthor || '未知作者'}}</text>
            </view>
            <view class="format-badge format-{{item.bookFormat || 'pdf'}}">{{(item.bookFormat || 'pdf').toUpperCase()}}</view>
            <view class="continue-progress-badge">
              <text class="continue-progress-text">{{item.progress}}%</text>
            </view>
          </view>
          <view class="continue-info">
            <text class="continue-title">{{item.bookTitle}}</text>
            <text class="continue-author">{{item.bookAuthor || '未知作者'}}</text>
            <view class="continue-progress-bar">
              <view class="continue-progress-fill" style="width: {{item.progress}}%"></view>
            </view>
            <view class="continue-meta">
              <text class="continue-meta-text">{{item.bookFormat === 'epub' ? '第' + (item.lastChapter || 0) + '/' + (item.chapterCount || 0) + '章' : '第' + item.lastPage + '/' + item.pageCount + '页'}}</text>
              <text class="continue-meta-text">{{item.durationText}}</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="book-grid {{viewMode === 'list' ? 'book-list' : ''}}" wx:if="{{books.length > 0}}">
    <view class="book-card {{item.selected ? 'book-card-selected' : ''}} {{viewMode === 'list' ? 'book-card-list' : ''}}"
      wx:for="{{books}}" wx:key="id" wx:for-index="idx"
      bindtap="openBook" data-id="{{item.id}}"
      bindlongpress="showBookAction" data-index="{{idx}}">
      <view class="checkbox-wrap" wx:if="{{batchMode}}">
        <view class="checkbox {{item.selected ? 'checkbox-checked' : ''}}">
          <text class="checkbox-check" wx:if="{{item.selected}}">✓</text>
        </view>
      </view>
      <view class="book-cover {{viewMode === 'list' ? 'book-cover-list' : ''}}" catchtap="goReader" data-id="{{item.id}}" data-format="{{item.bookFormat}}">
        <image wx:if="{{item.coverThumbnail && item.coverThumbnailUrl && !item.coverLoadFailed}}"
               class="cover-image"
               src="{{item.coverThumbnailUrl}}"
               mode="aspectFill"
               lazy-load="true"
               binderror="onBookCoverError"
               data-index="{{idx}}" />
        <view wx:else class="cover-placeholder">
          <text class="cover-title">{{item.title}}</text>
          <text class="cover-author">{{item.author || '未知作者'}}</text>
        </view>
        <view class="format-badge format-{{item.bookFormat || 'pdf'}}">{{(item.bookFormat || 'pdf').toUpperCase()}}</view>
        <view class="category-color-badge" wx:if="{{item.categoryColor}}" style="background: {{item.categoryColor}}"></view>
        <view class="progress-bar" wx:if="{{(item.bookFormat === 'epub' ? item.chapterCount : item.pageCount) > 0}}">
          <view class="progress-fill" style="width: {{item.progress}}%"></view>
        </view>
      </view>
      <view class="book-info {{viewMode === 'list' ? 'book-info-list' : ''}}">
        <text class="book-title">{{item.title}}</text>
        <text class="book-author-line" wx:if="{{viewMode === 'list'}}">{{item.author || '未知作者'}}</text>
        <view class="book-meta-row">
          <text class="book-meta">{{item.bookFormat === 'epub' ? (item.chapterCount || 0) + '章' : (item.pageCount || 0) + '页'}} · {{item.fileSizeText}}</text>
          <view class="book-category-tag" wx:if="{{item.categoryName}}" style="background: {{item.categoryColor || '#6B4226'}}20; color: {{item.categoryColor || '#6B4226'}}">
            <view class="book-category-dot" style="background: {{item.categoryColor || '#6B4226'}}"></view>
            <text class="book-category-text">{{item.categoryName}}</text>
          </view>
        </view>
        <view class="book-progress-row" wx:if="{{viewMode === 'list' && item.progress > 0}}">
          <view class="book-progress-bar">
            <view class="book-progress-fill" style="width: {{item.progress}}%"></view>
          </view>
          <text class="book-progress-text">{{item.progress}}%</text>
        </view>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{books.length === 0 && !loading}}">
    <view class="empty-icon-wrap">
      <view class="icon icon-books"></view>
    </view>
    <text class="empty-text">{{searchKeyword ? '没有找到匹配的书籍' : '书架空空如也'}}</text>
    <text class="empty-sub">{{searchKeyword ? '试试其他关键词' : '点击下方按钮上传你的第一本电子书'}}</text>
    <view class="empty-format-tips" wx:if="{{!searchKeyword}}">
      <text class="empty-format-item format-item-pdf">PDF</text>
      <text class="empty-format-item format-item-epub">EPUB</text>
      <text class="empty-format-item format-item-mobi">MOBI</text>
      <text class="empty-format-item format-item-mobi">AZW3</text>
    </view>
  </view>

  <view class="loading-tip" wx:if="{{loading && books.length > 0}}">
    <text class="loading-tip-text">加载中...</text>
  </view>

  <view class="batch-bar" wx:if="{{batchMode}}">
    <view class="batch-left">
      <view class="batch-select-all" bindtap="selectAll">
        <view class="checkbox {{selectedCount === books.length && books.length > 0 ? 'checkbox-checked' : ''}}">
          <text class="checkbox-check" wx:if="{{selectedCount === books.length && books.length > 0}}">✓</text>
        </view>
        <text class="batch-text">全选({{selectedCount}}/{{books.length}})</text>
      </view>
    </view>
    <view class="batch-right">
      <view class="batch-btn batch-btn-move" bindtap="showBatchMove">
        <text class="batch-btn-text">移动分类</text>
      </view>
      <view class="batch-btn batch-btn-delete" bindtap="confirmBatchDelete">
        <text class="batch-btn-text">删除</text>
      </view>
    </view>
  </view>

  <view class="fab-btn" wx:if="{{!batchMode}}" bindtap="uploadBook">
    <view class="icon icon-plus"></view>
  </view>

  <view class="copyright-mask" wx:if="{{showCopyrightModal}}" bindtap="cancelUpload"></view>
  <view class="copyright-modal" wx:if="{{showCopyrightModal}}" catchtap="noop">
    <text class="copyright-modal-title">版权声明</text>
    <text class="copyright-modal-desc">上传书籍前，请确认您拥有该书籍的版权或已获得授权。上传未经授权的内容可能会侵犯他人权益。</text>
    <view class="copyright-checkbox" catchtap="toggleCopyright">
      <view class="checkbox-icon {{copyrightDeclared ? 'checked' : ''}}">
        <view class="icon icon-check" wx:if="{{copyrightDeclared}}"></view>
      </view>
      <text class="checkbox-text">本人拥有版权或已获授权</text>
    </view>
    <view class="copyright-modal-actions">
      <view class="copyright-btn cancel" catchtap="cancelUpload">取消</view>
      <view class="copyright-btn confirm {{copyrightDeclared ? '' : 'disabled'}}" catchtap="confirmUpload">确认上传</view>
    </view>
  </view>

  <view class="edit-meta-mask" wx:if="{{showEditMetaModal}}" bindtap="skipEditMeta"></view>
  <view class="edit-meta-modal" wx:if="{{showEditMetaModal}}" catchtap="noop">
    <text class="edit-meta-title">编辑书籍信息</text>
    <text class="edit-meta-tip">已自动从文件提取元数据，您可以修改后保存</text>
    <view class="edit-field">
      <text class="edit-label">书名 *</text>
      <input class="edit-input" placeholder="请输入书名" value="{{editTitle}}" bindinput="onEditTitleInput" maxlength="200" />
    </view>
    <view class="edit-field">
      <text class="edit-label">作者</text>
      <input class="edit-input" placeholder="请输入作者（可选）" value="{{editAuthor}}" bindinput="onEditAuthorInput" maxlength="100" />
    </view>
    <view class="edit-meta-actions">
      <view class="edit-btn cancel" catchtap="skipEditMeta">跳过</view>
      <view class="edit-btn confirm" catchtap="confirmEditMeta">保存</view>
    </view>
  </view>

  <view class="batch-move-mask" wx:if="{{showBatchMoveModal}}" bindtap="cancelBatchMove"></view>
  <view class="batch-move-modal" wx:if="{{showBatchMoveModal}}" catchtap="noop">
    <text class="batch-move-title">选择目标分类</text>
    <text class="batch-move-sub">已选 {{selectedCount}} 本书</text>
    <scroll-view scroll-y class="batch-move-list">
      <view class="move-cat-item {{!moveCategoryId ? 'move-cat-active' : ''}}" bindtap="selectMoveCategory" data-id="">
        <view class="move-cat-dot" style="background: #6B4226"></view>
        <text class="move-cat-name">未分类</text>
        <view class="move-cat-check" wx:if="{{!moveCategoryId}}">✓</view>
      </view>
      <view class="move-cat-item {{moveCategoryId === item.id ? 'move-cat-active' : ''}}"
        wx:for="{{categories}}" wx:key="id" bindtap="selectMoveCategory" data-id="{{item.id}}">
        <view class="move-cat-dot" style="background: {{item.color || '#6B4226'}}"></view>
        <text class="move-cat-name">{{item.name}}</text>
        <view class="move-cat-check" wx:if="{{moveCategoryId === item.id}}">✓</view>
      </view>
    </scroll-view>
    <view class="batch-move-actions">
      <view class="move-btn cancel" catchtap="cancelBatchMove">取消</view>
      <view class="move-btn confirm" catchtap="confirmBatchMove">确认移动</view>
    </view>
  </view>
</view>
