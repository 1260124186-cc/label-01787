.page-bookshelf {
  min-height: 100vh;
  padding-bottom: 180rpx;
  background: #F5F0EB;
}

.top-bar {
  position: sticky;
  top: 0;
  z-index: 50;
  background: #fff;
  padding: 20rpx 24rpx 0;
  border-bottom: 1rpx solid #E8DFD4;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #F5F0EB;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
}

.search-icon {
  font-size: 28rpx;
  color: #999;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  min-width: 0;
}

.search-clear {
  font-size: 28rpx;
  color: #999;
  padding: 0 8rpx;
  flex-shrink: 0;
}

.tool-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0;
  overflow-x: auto;
}

.tool-btn {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 10rpx 20rpx;
  border-radius: 24rpx;
  background: #F5F0EB;
  flex-shrink: 0;
}

.tool-btn-active {
  background: #6B4226;
}

.tool-btn-active .tool-btn-text {
  color: #fff;
}

.tool-btn-text {
  font-size: 24rpx;
  color: #666;
  white-space: nowrap;
}

.tool-btn-arrow {
  font-size: 18rpx;
  color: #999;
}

.sort-picker {
  position: absolute;
  right: 24rpx;
  top: 180rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.12);
  padding: 8rpx 0;
  min-width: 240rpx;
  z-index: 100;
}

.sort-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
}

.sort-option-active .sort-option-text {
  color: #6B4226;
  font-weight: 600;
}

.sort-option-text {
  font-size: 28rpx;
  color: #333;
}

.sort-check {
  font-size: 28rpx;
  color: #6B4226;
  font-weight: 600;
}

.filter-bar {
  background: #fff;
  padding: 16rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
  margin-bottom: 4rpx;
}

.category-scroll {
  white-space: nowrap;
}

.category-chips {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 24rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 24rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  background: #F5F0EB;
  color: #666;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.chip:active {
  transform: scale(0.96);
}

.chip-active {
  background: #6B4226;
  color: #fff;
}

.chip-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.chip-active .chip-dot {
  background: #fff !important;
}

.chip-text {
  font-size: 24rpx;
  white-space: nowrap;
}

.chip-manage {
  background: transparent;
  color: #6B4226;
  border: 2rpx dashed #D4A574;
}

.continue-section {
  padding: 24rpx 0 0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.section-more {
  font-size: 24rpx;
  color: #999;
}

.continue-scroll {
  width: 100%;
  white-space: nowrap;
}

.continue-scroll-inner {
  display: inline-flex;
  gap: 20rpx;
  padding: 0 24rpx;
}

.continue-card {
  display: inline-flex;
  width: 420rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

.continue-card:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.continue-cover {
  position: relative;
  width: 160rpx;
  height: 210rpx;
  flex-shrink: 0;
}

.continue-cover-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #6B4226 0%, #8b5e3c 50%, #D4A574 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
}

.continue-cover-title {
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  word-break: break-all;
}

.continue-cover-author {
  color: rgba(255, 255, 255, 0.7);
  font-size: 18rpx;
  margin-top: 8rpx;
}

.continue-progress-badge {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 36rpx;
  background: rgba(107, 66, 38, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
}

.continue-progress-text {
  font-size: 20rpx;
  color: #fff;
  font-weight: 600;
}

.format-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
  font-weight: 600;
  color: #fff;
  z-index: 10;
}

.format-badge.format-pdf {
  background: linear-gradient(135deg, #E53935, #FF7043);
}

.format-badge.format-epub {
  background: linear-gradient(135deg, #43A047, #66BB6A);
}

.format-badge.format-mobi {
  background: linear-gradient(135deg, #1E88E5, #42A5F5);
}

.continue-info {
  flex: 1;
  padding: 16rpx 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.continue-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}

.continue-author {
  font-size: 22rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
  margin-top: 4rpx;
}

.continue-progress-bar {
  width: 100%;
  height: 8rpx;
  background: #f0f0f0;
  border-radius: 4rpx;
  margin-top: 12rpx;
  overflow: hidden;
}

.continue-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #6B4226, #E8734A);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.continue-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
}

.continue-meta-text {
  font-size: 20rpx;
  color: #999;
}

.book-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 24rpx;
  gap: 24rpx;
}

.book-list {
  flex-direction: column;
  gap: 16rpx;
}

.book-card {
  width: calc(33.33% - 16rpx);
  position: relative;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(107, 66, 38, 0.08);
  transition: all 0.2s ease;
}

.book-card-list {
  width: 100%;
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.book-card-selected {
  box-shadow: 0 0 0 4rpx #6B4226;
}

.checkbox-wrap {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  z-index: 20;
}

.book-card-list .checkbox-wrap {
  position: relative;
  top: auto;
  left: auto;
  align-self: center;
  margin-right: 8rpx;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid #ccc;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
}

.checkbox-checked {
  background: #6B4226;
  border-color: #6B4226;
}

.checkbox-check {
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
}

.book-cover {
  position: relative;
  width: 100%;
  height: 280rpx;
  border-radius: 12rpx 12rpx 0 0;
  overflow: hidden;
}

.book-cover-list {
  width: 160rpx;
  height: 210rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
}

.cover-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #6B4226 0%, #8b5e3c 50%, #D4A574 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
}

.cover-title {
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  word-break: break-all;
}

.cover-author {
  color: rgba(255,255,255,0.7);
  font-size: 20rpx;
  margin-top: 8rpx;
}

.progress-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: rgba(0,0,0,0.2);
}

.progress-fill {
  height: 100%;
  background: #E8734A;
  border-radius: 0 3rpx 3rpx 0;
  transition: width 0.3s;
}

.book-info {
  padding: 12rpx 4rpx;
}

.book-info-list {
  flex: 1;
  padding: 4rpx 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.book-title {
  font-size: 24rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}

.book-author-line {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}

.book-meta {
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}

.book-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 4rpx;
  gap: 8rpx;
}

.book-category-tag {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.book-category-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
}

.book-category-text {
  font-size: 18rpx;
  white-space: nowrap;
}

.category-color-badge {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  z-index: 10;
}

.book-progress-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
}

.book-progress-bar {
  flex: 1;
  height: 8rpx;
  background: #f0f0f0;
  border-radius: 4rpx;
  overflow: hidden;
}

.book-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #6B4226, #E8734A);
  border-radius: 4rpx;
}

.book-progress-text {
  font-size: 20rpx;
  color: #6B4226;
  font-weight: 600;
  flex-shrink: 0;
}

.empty-state {
  padding: 200rpx 0;
}

.empty-sub {
  font-size: 24rpx;
  color: #bbb;
  margin-top: 12rpx;
}

.empty-format-tips {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-top: 32rpx;
  flex-wrap: wrap;
}

.empty-format-item {
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
}

.format-item-pdf {
  background: linear-gradient(135deg, #E53935, #FF7043);
}

.format-item-epub {
  background: linear-gradient(135deg, #43A047, #66BB6A);
}

.format-item-mobi {
  background: linear-gradient(135deg, #1E88E5, #42A5F5);
}

.loading-tip {
  padding: 24rpx;
  text-align: center;
}

.loading-tip-text {
  font-size: 24rpx;
  color: #999;
}

.empty-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  margin-left: auto;
  margin-right: auto;
  color: #ccc;
}

.empty-icon-wrap .icon {
  transform: scale(2.5);
}

.empty-text {
  display: block;
  text-align: center;
  font-size: 30rpx;
  color: #666;
}

.empty-sub {
  display: block;
  text-align: center;
}

.batch-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.08);
  z-index: 100;
}

.batch-left {
  display: flex;
  align-items: center;
}

.batch-select-all {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.batch-text {
  font-size: 26rpx;
  color: #333;
}

.batch-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.batch-btn {
  padding: 14rpx 32rpx;
  border-radius: 40rpx;
}

.batch-btn-move {
  background: #F5F0EB;
}

.batch-btn-move .batch-btn-text {
  color: #6B4226;
}

.batch-btn-delete {
  background: #E53935;
}

.batch-btn-delete .batch-btn-text {
  color: #fff;
}

.batch-btn-text {
  font-size: 26rpx;
  font-weight: 500;
}

.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 200rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #6B4226;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(107, 66, 38, 0.4);
  z-index: 100;
  color: #fff;
}

.fab-btn:active {
  transform: scale(0.92);
}

.fab-btn .icon {
  display: flex;
  transform: scale(1.5);
}

.copyright-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 500;
}

.copyright-modal {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  z-index: 600;
}

.copyright-modal-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  margin-bottom: 24rpx;
}

.copyright-modal-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.copyright-checkbox {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.checkbox-icon {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.checkbox-icon.checked {
  background: #6B4226;
  border-color: #6B4226;
}

.checkbox-icon .icon {
  color: #fff;
  transform: scale(0.8);
}

.checkbox-text {
  font-size: 26rpx;
  color: #333;
}

.copyright-modal-actions {
  display: flex;
  gap: 24rpx;
}

.copyright-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.copyright-btn.cancel {
  background: #F5F0EB;
  color: #666;
}

.copyright-btn.confirm {
  background: #6B4226;
  color: #fff;
}

.copyright-btn.confirm.disabled {
  background: #D4A574;
  color: rgba(255, 255, 255, 0.6);
}

.edit-meta-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 500;
}

.edit-meta-modal {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 620rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  z-index: 600;
}

.edit-meta-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  margin-bottom: 8rpx;
}

.edit-meta-tip {
  display: block;
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-bottom: 32rpx;
}

.edit-field {
  margin-bottom: 24rpx;
}

.edit-label {
  display: block;
  font-size: 26rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.edit-input {
  width: 100%;
  box-sizing: border-box;
  height: 80rpx;
  padding: 0 24rpx;
  background: #F5F0EB;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
}

.edit-meta-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}

.edit-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.edit-btn.cancel {
  background: #F5F0EB;
  color: #666;
}

.edit-btn.confirm {
  background: #6B4226;
  color: #fff;
}

.batch-move-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 500;
}

.batch-move-modal {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  max-height: 80vh;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  z-index: 600;
  display: flex;
  flex-direction: column;
}

.batch-move-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
}

.batch-move-sub {
  display: block;
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-top: 8rpx;
  margin-bottom: 24rpx;
}

.batch-move-list {
  max-height: 480rpx;
  flex: 1;
}

.move-cat-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 16rpx;
  border-radius: 12rpx;
}

.move-cat-active {
  background: #F5F0EB;
}

.move-cat-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.move-cat-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.move-cat-check {
  font-size: 28rpx;
  color: #6B4226;
  font-weight: 600;
  flex-shrink: 0;
}

.batch-move-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 24rpx;
}

.move-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.move-btn.cancel {
  background: #F5F0EB;
  color: #666;
}

.move-btn.confirm {
  background: #6B4226;
  color: #fff;
}
