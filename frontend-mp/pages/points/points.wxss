.page-points {
  min-height: 100vh;
  background: #F5F0EB;
  padding-bottom: 40rpx;
}

.points-card {
  background: linear-gradient(135deg, #6B4226 0%, #8b5e3c 100%);
  padding: 60rpx 32rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.points-balance {
  font-size: 72rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.2;
}

.points-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 8rpx;
  margin-bottom: 24rpx;
}

.checkin-btn {
  padding: 16rpx 64rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 36rpx;
  line-height: normal;
}

.checkin-btn::after {
  border: none;
}

.checkin-btn.checked {
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.5);
}

.stats-row {
  display: flex;
  align-items: center;
  margin: 24rpx;
  padding: 32rpx;
  background: #fff;
  border-radius: 16rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #6B4226;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: #f0ebe5;
}

.section-card {
  margin: 24rpx;
  padding: 32rpx;
  background: #fff;
  border-radius: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 24rpx;
}

.history-list {
  display: flex;
  flex-direction: column;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f0eb;
}

.history-item:last-child {
  border-bottom: none;
}

.history-left {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.history-desc {
  font-size: 28rpx;
  color: #333;
}

.history-time {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 6rpx;
}

.history-amount {
  font-size: 30rpx;
  font-weight: 600;
  margin-left: 20rpx;
}

.history-amount.plus {
  color: #E8734A;
}

.history-amount.minus {
  color: #999;
}

.empty-tip {
  text-align: center;
  padding: 40rpx 0;
}

.empty-tip text {
  font-size: 26rpx;
  color: #ccc;
}

.load-more-tip {
  text-align: center;
  padding: 20rpx 0 0;
}

.load-more-tip text {
  font-size: 22rpx;
  color: #ccc;
}

.rules-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.rule-item {
  display: flex;
  align-items: center;
}

.rule-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: #f5f0eb;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.rule-icon-text {
  font-size: 36rpx;
}

.rule-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.rule-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.rule-desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.rule-points {
  font-size: 28rpx;
  font-weight: 600;
  color: #E8734A;
}