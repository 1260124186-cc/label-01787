.page-category {
  min-height: 100vh;
  padding: 24rpx;
}

.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.header-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.add-btn {
  padding: 12rpx 28rpx;
  background: #6B4226;
  color: #fff;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.add-btn:active {
  background: #8b5e3c;
}

.category-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.category-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.category-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.category-icon {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6B4226;
}

.category-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.category-actions {
  display: flex;
  gap: 24rpx;
}

.action-btn {
  font-size: 26rpx;
  color: #6B4226;
  padding: 8rpx 4rpx;
}

.action-btn.danger {
  color: #F56C6C;
}

.empty-sub {
  font-size: 24rpx;
  color: #bbb;
  margin-top: 12rpx;
}

.empty-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  color: #ccc;
}

.empty-icon-wrap .icon {
  transform: scale(2.5);
}
