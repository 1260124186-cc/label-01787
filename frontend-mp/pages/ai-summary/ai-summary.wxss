.page-ai-summary {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
  padding-bottom: 200rpx;
  box-sizing: border-box;
}

.header-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.book-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
}

.ai-badge {
  display: flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  margin-left: 16rpx;
}

.ai-badge.free {
  background: #f0f0f0;
  color: #666;
}

.ai-badge.vip {
  background: linear-gradient(135deg, #E8734A 0%, #d4622e 100%);
  color: #fff;
}

.ai-count {
  margin-left: 8rpx;
}

.summary-card {
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.key-points-title {
  margin-top: 32rpx;
}

.summary-content {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
}

.key-points {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.point-item {
  font-size: 28rpx;
  color: #555;
  line-height: 1.6;
  padding-left: 16rpx;
  position: relative;
}

.share-btn {
  width: 100%;
  height: 80rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 28rpx;
  border-radius: 40rpx;
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.share-btn::after {
  border: none;
}

.generating-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 32rpx;
}

.loading-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.generating-text {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.generating-tip {
  font-size: 24rpx;
  color: #999;
}

.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 32rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #999;
  text-align: center;
}

.bottom-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 24rpx 32rpx 48rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.generate-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #E8734A 0%, #d4622e 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.generate-btn.disabled {
  opacity: 0.6;
}

.generate-btn::after {
  border: none;
}

.btn-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}

.btn-tip.vip-tip {
  color: #E8734A;
}
