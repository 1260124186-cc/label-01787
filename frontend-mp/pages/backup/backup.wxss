.page-backup {
  min-height: 100vh;
  background: #F5F0EB;
  padding-bottom: 40rpx;
}

.login-tip {
  padding: 80rpx 40rpx;
}

.login-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 80rpx 40rpx;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

.login-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.login-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.login-desc {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 48rpx;
  line-height: 1.6;
}

.login-btn {
  background: linear-gradient(135deg, #8B6914, #6B4226);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  padding: 20rpx 0;
  width: 80%;
}

.tab-bar {
  display: flex;
  background: #fff;
  padding: 0 40rpx;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 32rpx 0;
  font-size: 30rpx;
  color: #999;
  position: relative;
  transition: all 0.3s;
}

.tab-item.active {
  color: #6B4226;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: #6B4226;
  border-radius: 3rpx;
}

.tab-content {
  padding: 32rpx;
}

.feature-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 32rpx;
}

.feature-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.feature-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.feature-desc {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 32rpx;
}

.feature-list {
  text-align: left;
  background: #F9F6F2;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  font-size: 28rpx;
  color: #555;
}

.feature-check {
  color: #67C23A;
  font-weight: bold;
  margin-right: 16rpx;
}

.feature-tip {
  background: #FFF7E6;
  color: #E6A23C;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  margin-bottom: 32rpx;
  text-align: left;
}

.import-tips {
  text-align: left;
  background: #F0F9EB;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
}

.import-tip-item {
  font-size: 26rpx;
  color: #67C23A;
  padding: 8rpx 0;
}

.primary-btn {
  background: linear-gradient(135deg, #8B6914, #6B4226);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  padding: 24rpx 0;
  width: 100%;
  border: none;
}

.tip-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
}

.tip-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.tip-content {
  padding-left: 16rpx;
}

.tip-step {
  font-size: 26rpx;
  color: #666;
  padding: 10rpx 0;
  line-height: 1.6;
}

.refresh-tip {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.refresh-icon {
  display: inline-block;
}

.refresh-icon.rotating {
  animation: rotate 1s linear infinite;
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.task-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.task-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.task-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.task-type {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.task-icon {
  font-size: 36rpx;
}

.task-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.task-status {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.status-0 {
  background: #F4F4F5;
  color: #909399;
}

.status-1 {
  background: #ECF5FF;
  color: #409EFF;
}

.status-2 {
  background: #F0F9EB;
  color: #67C23A;
}

.status-3 {
  background: #FEF0F0;
  color: #F56C6C;
}

.task-time {
  font-size: 24rpx;
  color: #999;
}

.task-progress {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.progress-bar {
  flex: 1;
  height: 12rpx;
  background: #F0F0F0;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #8B6914, #6B4226);
  border-radius: 6rpx;
  transition: width 0.3s;
}

.progress-text {
  font-size: 24rpx;
  color: #6B4226;
  font-weight: 600;
  min-width: 80rpx;
  text-align: right;
}

.task-stats {
  display: flex;
  background: #F9F6F2;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #6B4226;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
}

.task-error {
  background: #FEF0F0;
  color: #F56C6C;
  padding: 16rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  margin-bottom: 24rpx;
}

.task-footer {
  border-top: 1rpx solid #F0F0F0;
  padding-top: 24rpx;
}

.file-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.file-name {
  font-size: 26rpx;
  color: #666;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}

.file-size {
  font-size: 26rpx;
  color: #999;
}

.task-actions {
  display: flex;
  gap: 24rpx;
  justify-content: flex-end;
}

.action-btn {
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  background: #F5F0EB;
  color: #6B4226;
}

.action-btn.primary {
  background: linear-gradient(135deg, #8B6914, #6B4226);
  color: #fff;
}

.action-btn.danger {
  background: #FEF0F0;
  color: #F56C6C;
}

.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: #ccc;
}

.result-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}

.result-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.3s;
  z-index: 1001;
}

.result-panel.show {
  transform: translateY(0);
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.result-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.result-close {
  font-size: 36rpx;
  color: #999;
  padding: 8rpx;
}

.result-content {
  flex: 1;
  padding: 32rpx;
  overflow-y: auto;
}

.result-summary {
  display: flex;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.summary-card {
  flex: 1;
  text-align: center;
  padding: 24rpx 12rpx;
  border-radius: 16rpx;
}

.summary-card.success {
  background: #F0F9EB;
}

.summary-card.warning {
  background: #FDF6EC;
}

.summary-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.summary-count {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.summary-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.result-section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.book-link-item {
  background: #F9F6F2;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.book-link-info {
  flex: 1;
}

.book-link-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.book-link-author {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.book-link-stats {
  display: flex;
  gap: 24rpx;
  font-size: 24rpx;
  color: #666;
}

.book-link-tip {
  font-size: 22rpx;
  color: #E6A23C;
  background: #FFF7E6;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
}

.warning-item {
  background: #FDF6EC;
  color: #E6A23C;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  margin-bottom: 12rpx;
}

.result-footer {
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #F0F0F0;
}
