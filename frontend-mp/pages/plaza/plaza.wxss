.page-plaza {
  min-height: 100vh;
  background: #F5F0EB;
  padding-bottom: 120rpx;
}

.sort-tabs {
  display: flex;
  background: #fff;
  padding: 20rpx 24rpx;
  gap: 16rpx;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.tab {
  padding: 12rpx 40rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
  color: #666;
  background: #F5F0EB;
}

.tab.active {
  background: #6B4226;
  color: #fff;
}

.excerpt-list {
  padding: 24rpx;
}

.excerpt-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
}

.excerpt-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #F5F0EB;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.nickname {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.book-info {
  font-size: 24rpx;
  color: #999;
}

.excerpt-text {
  background: #F5F0EB;
  padding: 20rpx 24rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
  border-left: 6rpx solid #D4A574;
  margin-bottom: 16rpx;
}

.quote-mark {
  color: #D4A574;
  font-size: 40rpx;
  font-weight: 700;
  margin-right: 6rpx;
  vertical-align: top;
  line-height: 1;
}

.comment-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.7;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

.excerpt-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.time {
  font-size: 22rpx;
  color: #bbb;
}

.actions {
  display: flex;
  gap: 32rpx;
}

.action-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #999;
}

.action-item .iconfont {
  font-size: 28rpx;
}

.action-item.active {
  color: #E8734A;
}

.action-item.active .iconfont {
  color: #E8734A;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.loading-more,
.no-more {
  text-align: center;
  padding: 24rpx;
  font-size: 24rpx;
  color: #999;
}
