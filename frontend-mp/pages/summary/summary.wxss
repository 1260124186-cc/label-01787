.page-summary {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 120rpx;
}

.period-tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
}

.period-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #666;
  transition: all 0.2s;
}

.period-tab.active {
  background: #6B4226;
  color: #fff;
  font-weight: 600;
}

.overview-card {
  text-align: center;
}

.period-range {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 28rpx;
}

.stat-row {
  display: flex;
  align-items: center;
  justify-content: center;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-number {
  font-size: 48rpx;
  font-weight: 700;
  color: #6B4226;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: #eee;
}

.daily-card {
  margin-top: 0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 28rpx;
}

.daily-chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  height: 360rpx;
  padding-top: 40rpx;
}

.chart-bar-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.chart-bar {
  width: 40rpx;
  background: linear-gradient(180deg, #E8734A 0%, #D4A574 100%);
  border-radius: 8rpx 8rpx 0 0;
  min-height: 8rpx;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  position: relative;
}

.bar-value {
  position: absolute;
  top: -40rpx;
  font-size: 18rpx;
  color: #E8734A;
  white-space: nowrap;
}

.bar-label {
  font-size: 20rpx;
  color: #999;
  margin-top: 12rpx;
}

.period-tab.locked {
  color: #ccc;
  position: relative;
}

.lock-icon {
  font-size: 20rpx;
  margin-left: 4rpx;
}

.vip-upsell {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #FFF7F0 0%, #FFEDE0 100%);
  border-radius: 16rpx;
  border: 1rpx solid #FFD7B5;
}

.upsell-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.upsell-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.upsell-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #D9662A;
  margin-bottom: 4rpx;
}

.upsell-desc {
  font-size: 22rpx;
  color: #999;
}

.upsell-arrow {
  font-size: 32rpx;
  color: #D9662A;
}

.advanced-section {
  margin-top: 24rpx;
}

.rank-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.rank-item:last-child {
  border-bottom: none;
}

.rank-index {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border-radius: 50%;
  font-size: 24rpx;
  color: #999;
  margin-right: 20rpx;
}

.rank-index.top {
  background: linear-gradient(135deg, #E8734A 0%, #D4A574 100%);
  color: #fff;
  font-weight: 600;
}

.rank-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.rank-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 4rpx;
}

.rank-desc {
  font-size: 22rpx;
  color: #999;
}

.rank-duration {
  font-size: 26rpx;
  color: #E8734A;
  font-weight: 600;
}

.category-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.category-item {
  width: calc(50% - 8rpx);
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
}

.category-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.category-books {
  font-size: 22rpx;
  color: #999;
}

.category-duration {
  font-size: 24rpx;
  color: #E8734A;
  margin-top: 8rpx;
}

.insight-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.insight-item {
  width: calc(50% - 8rpx);
  padding: 24rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
}

.insight-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.insight-value {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
}

/* 阅读足迹时间线 */
.timeline-card {
  margin-top: 24rpx;
}

.timeline-list {
  display: flex;
  flex-direction: column;
}

.timeline-item {
  display: flex;
  min-height: 200rpx;
}

.timeline-date-col {
  width: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 8rpx;
  position: relative;
  flex-shrink: 0;
}

.timeline-date-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.timeline-day-of-week {
  font-size: 22rpx;
  color: #999;
  margin-top: 2rpx;
}

.timeline-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #eee;
  margin-top: 16rpx;
  position: relative;
  z-index: 1;
}

.timeline-dot.active {
  background: #6B4226;
}

.timeline-line {
  width: 4rpx;
  flex: 1;
  background: #eee;
  margin-top: 8rpx;
  min-height: 80rpx;
}

.timeline-content-col {
  flex: 1;
  padding-left: 24rpx;
  padding-bottom: 32rpx;
  min-width: 0;
}

.timeline-day-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
  padding-top: 8rpx;
}

.timeline-day-total {
  font-size: 24rpx;
  color: #E8734A;
  font-weight: 500;
}

.timeline-book-count {
  font-size: 20rpx;
  color: #999;
  background: #f5f0eb;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
}

.timeline-book-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.timeline-book-card:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.timeline-book-info {
  flex: 1;
  min-width: 0;
  margin-right: 20rpx;
}

.timeline-book-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}

.timeline-book-author {
  font-size: 22rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
  margin-top: 4rpx;
}

.timeline-book-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}

.timeline-book-duration {
  font-size: 24rpx;
  color: #6B4226;
  font-weight: 500;
}

.timeline-book-page {
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}

