<view class="page-summary">
  <view class="period-tabs">
    <view class="period-tab {{period === 'week' ? 'active' : ''}}" bindtap="setPeriod" data-period="week">本周</view>
    <view class="period-tab {{period === 'month' ? 'active' : ''}}" bindtap="setPeriod" data-period="month">本月</view>
    <view class="period-tab {{period === 'year' ? 'active' : ''}} {{!isVip ? 'locked' : ''}}" bindtap="setPeriod" data-period="year">
      本年
      <text class="lock-icon" wx:if="{{!isVip}}">🔒</text>
    </view>
  </view>

  <view class="goal-card card" wx:if="{{goalProgress}}">
    <view class="goal-header">
      <text class="goal-title">📖 今日阅读目标</text>
      <text class="goal-setting" bindtap="openGoalSetting">设置</text>
    </view>
    <view class="goal-content">
      <view class="progress-ring-wrap">
        <canvas canvas-id="progressCanvas" class="progress-canvas" style="width: {{canvasSize}}px; height: {{canvasSize}}px;"></canvas>
        <view class="progress-ring-inner">
          <text class="progress-value">{{goalProgress.dailyProgress.toFixed(1)}}%</text>
          <text class="progress-label">今日完成度</text>
        </view>
      </view>
      <view class="goal-stats">
        <view class="goal-stat-item">
          <text class="goal-stat-value">{{todayDurationText}}</text>
          <text class="goal-stat-label">已读时长</text>
        </view>
        <view class="goal-stat-item">
          <text class="goal-stat-value">{{dailyGoalMinutes}}分钟</text>
          <text class="goal-stat-label">目标时长</text>
        </view>
        <view class="goal-stat-item">
          <text class="goal-stat-value streak">{{streakDays}}天</text>
          <text class="goal-stat-label">连续阅读</text>
        </view>
      </view>
    </view>
    <view class="weekly-goal-row">
      <text class="weekly-label">本周目标</text>
      <view class="weekly-bar-wrap">
        <view class="weekly-bar" style="width: {{goalProgress.weeklyProgress > 100 ? 100 : goalProgress.weeklyProgress}}%;"></view>
      </view>
      <text class="weekly-text">{{weekDurationText}} / {{weeklyGoalMinutes}}分钟</text>
    </view>
    <view class="max-streak-row">
      <text class="max-streak-text">🏆 最长连续阅读：{{maxStreakDays}}天</text>
    </view>
  </view>

  <view class="overview-card card">
    <view class="period-range">{{summary.periodStart}} ~ {{summary.periodEnd}}</view>
    <view class="stat-row">
      <view class="stat-item">
        <text class="stat-number">{{durationText}}</text>
        <text class="stat-label">阅读时长</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-number">{{summary.bookCount || 0}}</text>
        <text class="stat-label">阅读书籍</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-number">{{summary.readingDays || 0}}</text>
        <text class="stat-label">阅读天数</text>
      </view>
    </view>

    <view class="vip-upsell" wx:if="{{!isVip}}" bindtap="goMembership">
      <text class="upsell-icon">✨</text>
      <view class="upsell-text">
        <text class="upsell-title">升级会员解锁高级统计</text>
        <text class="upsell-desc">查看年度趋势、书籍排行、分类统计等更多数据</text>
      </view>
      <text class="upsell-arrow">›</text>
    </view>
  </view>

  <view class="daily-card card">
    <text class="section-title">每日阅读</text>
    <view class="daily-chart">
      <view class="chart-bar-wrap" wx:for="{{dailyData}}" wx:key="date">
        <view class="chart-bar" style="height: {{item.height}}rpx;">
          <text class="bar-value" wx:if="{{item.minutes > 0}}">{{item.minutes}}分</text>
        </view>
        <text class="bar-label">{{item.label}}</text>
      </view>
    </view>
    <view class="empty-state" wx:if="{{dailyData.length === 0}}" style="padding: 60rpx 0;">
      <text class="empty-text">暂无阅读数据</text>
    </view>
  </view>

  <view class="report-entry card" bindtap="goReport">
    <view class="report-entry-left">
      <text class="report-icon">📊</text>
      <view class="report-entry-info">
        <text class="report-entry-title">生成阅读报告</text>
        <text class="report-entry-desc">总时长、读完书籍、批注数、最长连续日</text>
      </view>
    </view>
    <text class="report-arrow">›</text>
  </view>

  <view class="advanced-section card" wx:if="{{isVip && summary.bookRank && summary.bookRank.length > 0}}">
    <text class="section-title">📚 书籍排行 Top5</text>
    <view class="rank-list">
      <view class="rank-item" wx:for="{{summary.bookRank}}" wx:key="bookId" wx:for-index="idx">
        <view class="rank-index {{idx < 3 ? 'top' : ''}}">{{idx + 1}}</view>
        <view class="rank-info">
          <text class="rank-title">{{item.bookTitle}}</text>
          <text class="rank-desc">{{item.readCount}}次阅读</text>
        </view>
        <text class="rank-duration">{{item.totalDurationText}}</text>
      </view>
    </view>
  </view>

  <view class="advanced-section card" wx:if="{{isVip && summary.categoryStats && summary.categoryStats.length > 0}}">
    <text class="section-title">🏷️ 分类汇总</text>
    <view class="category-list">
      <view class="category-item" wx:for="{{summary.categoryStats}}" wx:key="categoryId">
        <text class="category-name">{{item.categoryName || '未分类'}}</text>
        <view class="category-info">
          <text class="category-books">{{item.bookCount}}本</text>
          <text class="category-duration">{{item.totalDurationText}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="advanced-section card" wx:if="{{isVip}}">
    <text class="section-title">📊 阅读洞察</text>
    <view class="insight-grid">
      <view class="insight-item">
        <text class="insight-label">日均阅读</text>
        <text class="insight-value">{{summary.avgDailyDuration || '0分钟'}}</text>
      </view>
      <view class="insight-item">
        <text class="insight-label">阅读天数</text>
        <text class="insight-value">{{summary.readingDays || 0}}天</text>
      </view>
      <view class="insight-item">
        <text class="insight-label">最长单日</text>
        <text class="insight-value">{{summary.maxDayDuration || '0分钟'}}</text>
      </view>
      <view class="insight-item">
        <text class="insight-label">峰值日期</text>
        <text class="insight-value">{{summary.maxDayDate || '-'}}</text>
      </view>
    </view>
  </view>

  <view class="timeline-card card" wx:if="{{timeline.length > 0}}">
    <text class="section-title">📚 阅读足迹</text>
    <view class="timeline-list">
      <view class="timeline-item" wx:for="{{timeline}}" wx:key="date" wx:for-item="dayItem">
        <view class="timeline-date-col">
          <text class="timeline-date-label">{{dayItem.dateLabel}}</text>
          <text class="timeline-day-of-week">{{dayItem.dayOfWeek}}</text>
          <view class="timeline-dot {{dayItem.isLast ? '' : 'active'}}"></view>
          <view class="timeline-line" wx:if="{{!dayItem.isLast}}"></view>
        </view>
        <view class="timeline-content-col">
          <view class="timeline-day-header">
            <text class="timeline-day-total">共读 {{dayItem.totalMin}} 分钟</text>
            <text class="timeline-book-count">{{dayItem.books.length}} 本书</text>
          </view>
          <view class="timeline-book-card" wx:for="{{dayItem.books}}" wx:key="bookId" wx:for-item="bookItem"
            bindtap="openTimelineBook" data-id="{{bookItem.bookId}}">
            <view class="timeline-book-info">
              <text class="timeline-book-title">{{bookItem.bookTitle}}</text>
              <text class="timeline-book-author">{{bookItem.bookAuthor || '未知作者'}}</text>
            </view>
            <view class="timeline-book-meta">
              <text class="timeline-book-duration">{{bookItem.durationText}}</text>
              <text class="timeline-book-page">至第{{bookItem.lastPage}}页</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="goal-setting-mask" wx:if="{{showGoalSetting}}" bindtap="closeGoalSetting"></view>
  <view class="goal-setting-panel {{showGoalSetting ? 'show' : ''}}">
    <view class="goal-setting-header">
      <text class="goal-setting-title">设置阅读目标</text>
      <text class="goal-setting-close" bindtap="closeGoalSetting">×</text>
    </view>
    <view class="goal-setting-content">
      <view class="setting-section">
        <text class="setting-label">每日目标（分钟）</text>
        <slider class="setting-slider" min="5" max="300" step="5" value="{{tempDailyGoal}}" show-value bindchange="onDailyGoalChange" activeColor="#6B4226" backgroundColor="#e0e0e0" block-color="#6B4226" block-size="20"/>
      </view>
      <view class="setting-section">
        <text class="setting-label">每周目标（分钟）</text>
        <slider class="setting-slider" min="30" max="2100" step="30" value="{{tempWeeklyGoal}}" show-value bindchange="onWeeklyGoalChange" activeColor="#6B4226" backgroundColor="#e0e0e0" block-color="#6B4226" block-size="20"/>
      </view>
      <view class="setting-section">
        <text class="setting-label">目标类型</text>
        <view class="goal-type-selector">
          <view class="goal-type-option {{goalType === 1 ? 'active' : ''}}" bindtap="onGoalTypeChange" data-type="1">每日目标</view>
          <view class="goal-type-option {{goalType === 2 ? 'active' : ''}}" bindtap="onGoalTypeChange" data-type="2">每周目标</view>
          <view class="goal-type-option {{goalType === 3 ? 'active' : ''}}" bindtap="onGoalTypeChange" data-type="3">两者都有</view>
        </view>
      </view>
    </view>
    <view class="goal-setting-footer">
      <button class="save-goal-btn" bindtap="saveGoal">保存设置</button>
    </view>
  </view>
</view>
