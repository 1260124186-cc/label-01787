.detail-page {
  min-height: 100vh;
  background: #F7F7FA;
  padding-bottom: 60rpx;
}

.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #E8E8E8;
  border-top-color: #4A90D9;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  color: #999;
  font-size: 26rpx;
}

.detail-header {
  display: flex;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 32rpx 80rpx;
}

.cover-wrap {
  width: 200rpx;
  height: 280rpx;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
  flex-shrink: 0;
}

.cover-img {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #F5A623, #E8734A);
  display: flex;
  align-items: center;
  justify-content: center;
}

.cover-text {
  color: #FFF;
  font-size: 80rpx;
  font-weight: bold;
}

.header-info {
  flex: 1;
  margin-left: 32rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.book-title {
  color: #FFF;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.book-author {
  color: rgba(255, 255, 255, 0.85);
  font-size: 26rpx;
  margin-top: 12rpx;
}

.header-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.tag {
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #FFF;
}

.format-tag {
  background: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(4px);
}

.category-tag {
  opacity: 0.9;
}

.action-bar {
  display: flex;
  margin: -40rpx 32rpx 0;
  background: #FFF;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  align-items: center;
  gap: 20rpx;
}

.btn-read {
  flex: 1;
  height: 80rpx;
  background: linear-gradient(135deg, #4A90D9, #50E3C2);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #FFF;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-secondary {
  width: 120rpx;
  height: 80rpx;
  background: #F5F5F7;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #333;
  font-size: 26rpx;
}

.btn-bilingual {
  width: auto;
  padding: 0 24rpx;
  background: linear-gradient(135deg, #FFE5B4, #FFC88A);
  color: #8B4513;
  font-weight: 500;
}

.btn-more {
  width: 80rpx;
  font-size: 32rpx;
}

.btn-icon {
  font-size: 28rpx;
}

.progress-section,
.meta-section {
  margin: 32rpx;
  background: #FFF;
  border-radius: 16rpx;
  padding: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 28rpx;
}

.progress-wrap {
  display: flex;
  align-items: center;
  gap: 40rpx;
}

.progress-circle {
  width: 180rpx;
  height: 180rpx;
  flex-shrink: 0;
}

.progress-ring {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.progress-inner {
  width: 140rpx;
  height: 140rpx;
  background: #FFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.progress-percent {
  font-size: 34rpx;
  font-weight: bold;
  color: #4A90D9;
}

.progress-info {
  flex: 1;
  min-width: 0;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F0F0F3;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #999;
}

.info-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.meta-grid {
  display: flex;
  flex-wrap: wrap;
}

.meta-item {
  width: 50%;
  padding: 16rpx 0;
}

.meta-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.meta-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.excerpt-entry {
  margin: 0 32rpx;
  background: #FFF;
  border-radius: 16rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.entry-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.entry-arrow {
  font-size: 36rpx;
  color: #CCC;
}

.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 99;
}

.action-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #F7F7FA;
  z-index: 100;
  padding: 20rpx 0 calc(20rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
}

.action-sheet-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background: #FFF;
  padding: 32rpx;
  margin: 0 24rpx 16rpx;
  border-radius: 16rpx;
}

.sheet-icon {
  font-size: 36rpx;
  color: #333;
}

.sheet-icon.danger {
  color: #F56C6C;
}

.sheet-text {
  font-size: 30rpx;
  color: #333;
}

.sheet-text.danger {
  color: #F56C6C;
}

.action-sheet-cancel {
  background: #FFF;
  padding: 32rpx;
  margin: 0 24rpx;
  border-radius: 16rpx;
  text-align: center;
  font-size: 30rpx;
  color: #999;
}

.confirm-modal {
  position: fixed;
  left: 80rpx;
  right: 80rpx;
  top: 50%;
  transform: translateY(-50%);
  background: #FFF;
  border-radius: 20rpx;
  z-index: 101;
  overflow: hidden;
}

.modal-title {
  padding: 40rpx 32rpx 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
}

.modal-content {
  padding: 0 32rpx 40rpx;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  text-align: center;
}

.modal-btns {
  display: flex;
  border-top: 1rpx solid #F0F0F3;
}

.modal-btn {
  flex: 1;
  padding: 30rpx;
  text-align: center;
  font-size: 30rpx;
}

.modal-btn.cancel {
  color: #999;
  border-right: 1rpx solid #F0F0F3;
}

.modal-btn.confirm {
  color: #F56C6C;
  font-weight: 500;
}

.bilingual-section {
  margin: 32rpx;
  background: #FFF;
  border-radius: 16rpx;
  padding: 32rpx;
}

.bilingual-section .section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.add-pair-link {
  font-size: 26rpx;
  color: #4A90D9;
  font-weight: normal;
}

.bilingual-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.bilingual-item {
  background: linear-gradient(135deg, #FFF9F0 0%, #FFF3E0 100%);
  border: 1rpx solid #FFE0B2;
  border-radius: 14rpx;
  padding: 24rpx;
}

.bilingual-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.bilingual-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 12rpx;
}

.bilingual-badge {
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  flex-shrink: 0;
}

.bilingual-badge.strategy-1 {
  background: #E3F2FD;
  color: #1976D2;
}

.bilingual-badge.strategy-2 {
  background: #F3E5F5;
  color: #7B1FA2;
}

.bilingual-books {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.bilingual-book {
  flex: 1;
  background: #FFF;
  border-radius: 10rpx;
  padding: 16rpx;
  min-width: 0;
}

.bilingual-book.left {
  border-left: 4rpx solid #4A90D9;
}

.bilingual-book.right {
  border-left: 4rpx solid #FF7043;
}

.book-lang {
  display: inline-block;
  background: #F0F4F8;
  color: #666;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
  margin-bottom: 8rpx;
}

.book-title-small {
  display: block;
  font-size: 24rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bilingual-arrow {
  color: #FFB74D;
  font-size: 36rpx;
  flex-shrink: 0;
}

.bilingual-progress-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 22rpx;
  color: #666;
}

.mini-progress {
  flex: 1;
  height: 8rpx;
  background: #F0F0F0;
  border-radius: 4rpx;
  overflow: hidden;
  min-width: 40rpx;
}

.mini-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4A90D9, #50E3C2);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.mini-progress-text {
  font-size: 22rpx;
  color: #999;
  flex-shrink: 0;
  min-width: 60rpx;
}
