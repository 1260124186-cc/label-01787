.trash-page {
  min-height: 100vh;
  background: #F7F7FA;
  padding: 24rpx;
}

.trash-header {
  background: #FFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.header-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.header-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  padding-top: 200rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #E8E8E8;
  border-top-color: #4A90D9;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 120rpx;
  opacity: 0.3;
}

.empty-text {
  margin-top: 32rpx;
  font-size: 28rpx;
  color: #999;
}

.empty-back {
  margin-top: 40rpx;
  padding: 20rpx 48rpx;
  background: #4A90D9;
  color: #FFF;
  border-radius: 36rpx;
  font-size: 26rpx;
}

.book-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.book-card {
  display: flex;
  background: #FFF;
  border-radius: 16rpx;
  padding: 24rpx;
  gap: 24rpx;
  align-items: center;
  opacity: 0.85;
}

.cover-wrap {
  width: 120rpx;
  height: 160rpx;
  border-radius: 8rpx;
  overflow: hidden;
  position: relative;
  flex-shrink: 0;
}

.cover-img {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #A8D5AF, #7ED321);
  display: flex;
  align-items: center;
  justify-content: center;
}

.cover-text {
  color: #FFF;
  font-size: 48rpx;
  font-weight: bold;
}

.remain-badge {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  padding: 4rpx 10rpx;
  background: #4A90D9;
  color: #FFF;
  font-size: 18rpx;
  border-radius: 8rpx;
}

.remain-badge.warning {
  background: #F56C6C;
}

.book-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.book-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.book-author {
  font-size: 24rpx;
  color: #999;
}

.book-category {
  display: inline-block;
  align-self: flex-start;
  padding: 4rpx 14rpx;
  background: #F0F5FF;
  color: #4A90D9;
  font-size: 22rpx;
  border-radius: 8rpx;
  margin-top: 4rpx;
}

.book-meta {
  margin-top: 4rpx;
}

.meta-item {
  font-size: 22rpx;
  color: #BBB;
}

.action-wrap {
  flex-shrink: 0;
}

.btn-restore {
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, #4A90D9, #50E3C2);
  color: #FFF;
  font-size: 26rpx;
  border-radius: 32rpx;
  font-weight: 500;
}

.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 99;
}

.confirm-modal {
  position: fixed;
  left: 80rpx;
  right: 80rpx;
  top: 50%;
  transform: translateY(-50%);
  background: #FFF;
  border-radius: 20rpx;
  z-index: 101;
  overflow: hidden;
}

.modal-title {
  padding: 40rpx 32rpx 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
}

.modal-content {
  padding: 0 32rpx 40rpx;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  text-align: center;
}

.modal-btns {
  display: flex;
  border-top: 1rpx solid #F0F0F3;
}

.modal-btn {
  flex: 1;
  padding: 30rpx;
  text-align: center;
  font-size: 30rpx;
}

.modal-btn.cancel {
  color: #999;
  border-right: 1rpx solid #F0F0F3;
}

.modal-btn.confirm {
  color: #4A90D9;
  font-weight: 500;
}
