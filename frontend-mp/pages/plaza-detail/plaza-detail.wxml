<view class="page-detail" wx:if="{{excerpt}}">
  <view class="detail-card">
    <view class="excerpt-header">
      <image class="avatar" src="{{excerpt.avatar || '/assets/icon-user.png'}}" mode="aspectFill" />
      <view class="user-info">
        <text class="nickname">{{excerpt.nickname || '书友'}}</text>
        <text class="book-info">《{{excerpt.bookTitle}}》· {{excerpt.bookAuthor || '佚名'}}</text>
      </view>
    </view>

    <view class="excerpt-text">
      <text class="quote-mark">"</text>
      <text>{{excerpt.excerptText}}</text>
    </view>

    <view class="comment-text" wx:if="{{excerpt.commentText}}">
      <text>{{excerpt.commentText}}</text>
    </view>

    <view class="excerpt-footer">
      <text class="time">{{excerpt.createdAt}}</text>
      <view class="stats">
        <text class="stat-item">❤ {{excerpt.likes || 0}}</text>
        <text class="stat-item">★ {{excerpt.favorites || 0}}</text>
        <text class="stat-item">👁 {{excerpt.views || 0}}</text>
      </view>
    </view>
  </view>

  <view class="action-bar">
    <view class="action-btn {{excerpt.liked ? 'active' : ''}}" bindtap="toggleLike">
      <text class="icon">❤</text>
      <text class="label">{{excerpt.liked ? '已赞' : '点赞'}}</text>
    </view>
    <view class="action-btn {{excerpt.favorited ? 'active' : ''}}" bindtap="toggleFavorite">
      <text class="icon">★</text>
      <text class="label">{{excerpt.favorited ? '已收藏' : '收藏'}}</text>
    </view>
    <view class="action-btn" bindtap="showReport">
      <text class="icon">⚠</text>
      <text class="label">举报</text>
    </view>
    <view class="action-btn primary" bindtap="shareExcerpt">
      <text class="icon">↗</text>
      <text class="label">分享</text>
    </view>
  </view>

  <view class="withdraw-btn" wx:if="{{isOwner && excerpt.status === 1}}" bindtap="withdraw">
    撤回来
  </view>
</view>

<view class="report-modal" wx:if="{{showReportModal}}" catchtap="hideReport">
  <view class="report-content" catchtap="stopPropagation">
    <view class="report-title">举报书摘</view>
    <view class="report-reasons">
      <view class="reason-item {{selectedReason === item ? 'selected' : ''}}" 
            wx:for="{{reportReasons}}" wx:key="*this" 
            bindtap="selectReason" data-reason="{{item}}">
        {{item}}
      </view>
    </view>
    <textarea class="report-detail" placeholder="请补充详细描述（选填）" value="{{reportDetail}}" bindinput="onDetailInput" />
    <view class="report-actions">
      <button class="cancel-btn" bindtap="hideReport">取消</button>
      <button class="confirm-btn" bindtap="submitReport" disabled="{{!selectedReason}}">提交</button>
    </view>
  </view>
</view>
