.page-history {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 40rpx;
  background: #F5F0EB;
}

.filter-tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.filter-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.2s;
}

.filter-tab.active {
  background: #6B4226;
  color: #fff;
  font-weight: 600;
}

.report-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.report-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.report-item:active {
  opacity: 0.9;
}

.report-item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.report-type-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.type-icon {
  font-size: 32rpx;
}

.type-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #6B4226;
}

.report-date {
  font-size: 22rpx;
  color: #999;
}

.report-item-period {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.report-item-stats {
  display: flex;
  padding: 20rpx 0;
  border-top: 1rpx solid #f5f5f5;
  border-bottom: 1rpx solid #f5f5f5;
  margin-bottom: 20rpx;
}

.report-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.report-stat-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.report-stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

.report-item-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  height: 64rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0;
  line-height: 1;
}

.action-btn.share {
  background: #f5f0eb;
  color: #6B4226;
}

.action-btn.delete {
  background: #FFF0F0;
  color: #E53935;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.generate-btn {
  background: linear-gradient(135deg, #6B4226 0%, #8B5A2B 100%);
  color: #fff;
  font-size: 28rpx;
  height: 80rpx;
  padding: 0 60rpx;
  border-radius: 40rpx;
  border: none;
}

.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
  gap: 12rpx;
}

.loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: #6B4226;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-spinner.small {
  width: 32rpx;
  height: 32rpx;
  border-width: 3rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.load-more-text {
  font-size: 24rpx;
  color: #999;
}

.no-more {
  text-align: center;
  padding: 32rpx 0;
  font-size: 24rpx;
  color: #ccc;
}

.confirm-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.confirm-modal {
  width: 560rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  transform: scale(0.9);
  opacity: 0;
  transition: all 0.2s ease;
}

.confirm-modal.show {
  transform: scale(1);
  opacity: 1;
}

.confirm-modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  padding: 40rpx 32rpx 16rpx;
}

.confirm-modal-content {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  padding: 0 32rpx 32rpx;
  line-height: 1.6;
}

.confirm-modal-footer {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
}

.confirm-btn {
  flex: 1;
  height: 96rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  background: #fff;
}

.confirm-btn.cancel {
  color: #666;
  border-right: 1rpx solid #f0f0f0;
}

.confirm-btn.confirm {
  color: #E53935;
  font-weight: 500;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}
