.page-membership {
  min-height: 100vh;
  background: #F5F0EB;
  padding-bottom: 40rpx;
}

.user-plan-card {
  background: linear-gradient(135deg, #6B4226 0%, #8b5e3c 100%);
  padding: 60rpx 32rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.plan-badge {
  padding: 12rpx 40rpx;
  border-radius: 32rpx;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.plan-badge.free {
  background: rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.9);
}

.plan-badge.vip {
  background: linear-gradient(135deg, #FFD700, #FFA500);
  color: #6B4226;
}

.plan-expire {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.section-card {
  margin: 24rpx;
  padding: 32rpx;
  background: #fff;
  border-radius: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 24rpx;
}

.quota-item {
  margin-bottom: 24rpx;
}

.quota-item:last-child {
  margin-bottom: 0;
}

.quota-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.quota-label {
  font-size: 26rpx;
  color: #666;
}

.quota-value {
  font-size: 26rpx;
  color: #6B4226;
  font-weight: 600;
}

.quota-bar {
  height: 12rpx;
  background: #f0ebe5;
  border-radius: 6rpx;
  overflow: hidden;
}

.quota-bar-fill {
  height: 100%;
  background: #6B4226;
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.plans-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.plan-card {
  flex: 1;
  padding: 28rpx 20rpx;
  border: 2rpx solid #e8e0d8;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.plan-card.current {
  border-color: #6B4226;
}

.plan-card.vip-plan.current {
  border-color: #E8734A;
  background: #fffbf7;
}

.plan-card-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.plan-card-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #E8734A;
  margin-bottom: 20rpx;
}

.plan-features {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.plan-feature {
  font-size: 22rpx;
  color: #888;
}

.plan-card-tag {
  position: absolute;
  top: 0;
  right: 0;
  background: #6B4226;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 0 14rpx 0 12rpx;
}

.plan-card.vip-plan.current .plan-card-tag {
  background: #E8734A;
}

.purchase-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #6B4226 0%, #8b5e3c 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.purchase-btn::after {
  border: none;
}

.renew-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #E8734A 0%, #d4622e 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.renew-btn::after {
  border: none;
}

.exchange-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.exchange-info {
  display: flex;
  flex-direction: column;
}

.exchange-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.exchange-desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.exchange-action {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.exchange-input {
  width: 100rpx;
  height: 64rpx;
  background: #f5f0eb;
  border-radius: 8rpx;
  text-align: center;
  font-size: 26rpx;
  color: #333;
}

.exchange-unit {
  font-size: 24rpx;
  color: #666;
}

.exchange-btn {
  height: 64rpx;
  padding: 0 28rpx;
  background: #6B4226;
  color: #fff;
  font-size: 24rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
}

.exchange-btn::after {
  border: none;
}

.exchange-divider {
  height: 1rpx;
  background: #f0ebe5;
}

.exchange-points-tip {
  margin-top: 20rpx;
  text-align: center;
}

.exchange-points-tip text {
  font-size: 24rpx;
  color: #999;
}
