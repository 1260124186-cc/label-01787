.reader-page {
  min-height: 100vh;
  position: relative;
  background-color: #FFFFFF;
}

page {
  background-color: #FFFFFF;
}

/* 主题样式覆盖 */
.reader-page.theme-white {
  --bg-color: #FFFFFF;
  --text-color: #333333;
  background-color: #FFFFFF;
}

.reader-page.theme-green {
  --bg-color: #EBF9ED;
  --text-color: #2D4A2D;
  background-color: #EBF9ED;
}

.reader-page.theme-dark {
  --bg-color: #1A1A2E;
  --text-color: #E0E0E0;
  background-color: #1A1A2E;
}

/* 顶部栏 */
.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  padding-top: 44rpx;
  background: rgba(0,0,0,0.7);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 24rpx;
  padding-right: 24rpx;
  z-index: 200;
  color: #fff;
}

.bar-left, .bar-right {
  padding: 12rpx 20rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
}

.bar-left .icon {
  color: #fff;
}

.bar-title {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 0 20rpx;
}

/* 滚动阅读 */
.scroll-reader {
  height: 100vh;
  width: 100%;
}

.page-image-wrap {
  width: 100%;
  position: relative;
}

.page-image {
  width: 100%;
  display: block;
}

/* 护眼模式 - 用真实遮罩层覆盖图片，统一绿色背景 */
/* 遮罩 rgba(199,237,204,0.35) 盖在白底上混合色约为 #EBF9ED */
.theme-green .page-image-wrap {
  position: relative;
  background-color: #EBF9ED;
}

.green-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(199, 237, 204, 0.35);
  pointer-events: none;
}

.theme-green .scroll-reader,
.theme-green .swipe-reader,
.theme-green .swiper-page-scroll {
  background-color: #EBF9ED !important;
}

.theme-green .load-more,
.theme-green .load-end {
  color: #2D4A2D;
}

/* 夜间模式 - 反色+降低亮度 */
.theme-dark .page-image-wrap {
  background-color: #1A1A2E;
}

.theme-dark .page-image {
  filter: invert(90%) hue-rotate(180deg) brightness(90%) contrast(90%);
}

.theme-dark .scroll-reader,
.theme-dark .swipe-reader,
.theme-dark .swiper-page-scroll {
  background-color: #1A1A2E !important;
}

.theme-dark .load-more,
.theme-dark .load-end {
  color: #E0E0E0;
}

.load-more {
  text-align: center;
  padding: 40rpx;
  color: #6B4226;
  font-size: 28rpx;
}

.load-more:active {
  opacity: 0.7;
}

.load-end {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 26rpx;
}

/* 翻页阅读 */
.swipe-reader {
  height: 100vh;
  width: 100%;
}

.swiper-page-scroll {
  height: 100vh;
}

/* ========== HTML 流渲染 (EPUB) ========== */
.html-reader {
  padding: 0;
}

.chapter-wrap {
  width: 100%;
  padding: 20rpx 0 40rpx;
  box-sizing: border-box;
}

.chapter-title-bar {
  padding: 40rpx 40rpx 20rpx;
  border-bottom: 2rpx solid rgba(107, 66, 38, 0.15);
  margin-bottom: 24rpx;
}

.chapter-title-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  line-height: 1.5;
}

.chapter-body {
  padding: 0 32rpx;
  font-size: 30rpx;
  line-height: 1.9;
  color: #333;
  word-wrap: break-word;
  word-break: break-all;
}

/* rich-text 主题样式 */
.rich-text-white {
  color: #333333;
}

.rich-text-green {
  color: #2D4A2D;
}

.rich-text-dark {
  color: #E0E0E0;
}

/* 主题覆盖 rich-text 内部常见元素 */
.html-reader .chapter-body p,
.html-reader .chapter-body div,
.html-reader .chapter-body span {
  line-height: 1.9 !important;
}

.html-reader .chapter-body img {
  max-width: 100% !important;
  height: auto !important;
  display: block;
  margin: 20rpx auto;
  border-radius: 8rpx;
}

.html-reader .chapter-body h1,
.html-reader .chapter-body h2,
.html-reader .chapter-body h3 {
  margin: 32rpx 0 20rpx;
  font-weight: 700;
  line-height: 1.4;
}

.html-reader .chapter-body h1 { font-size: 40rpx; }
.html-reader .chapter-body h2 { font-size: 34rpx; }
.html-reader .chapter-body h3 { font-size: 32rpx; }

.html-reader .chapter-body blockquote {
  margin: 24rpx 0;
  padding: 20rpx 24rpx;
  border-left: 6rpx solid #D4A574;
  background: rgba(212, 165, 116, 0.1);
  border-radius: 0 8rpx 8rpx 0;
  font-style: italic;
}

.html-reader .chapter-body hr {
  border: none;
  height: 2rpx;
  background: rgba(107, 66, 38, 0.2);
  margin: 32rpx 0;
}

.html-reader .chapter-body ul,
.html-reader .chapter-body ol {
  padding-left: 48rpx;
  margin: 16rpx 0;
}

.html-reader .chapter-body li {
  margin: 12rpx 0;
}

.html-reader .chapter-body a {
  color: #6B4226;
  text-decoration: none;
}

/* 主题适配 */
.theme-green .chapter-title-text { color: #2D4A2D; }
.theme-green .chapter-body { color: #2D4A2D; }
.theme-green .chapter-title-bar { border-bottom-color: rgba(45, 74, 45, 0.2); }
.theme-green blockquote { background: rgba(45, 74, 45, 0.08); border-left-color: #67C23A; }

.theme-dark .chapter-title-text { color: #E0E0E0; }
.theme-dark .chapter-body { color: #E0E0E0; }
.theme-dark .chapter-title-bar { border-bottom-color: rgba(224, 224, 224, 0.15); }
.theme-dark blockquote { background: rgba(224, 224, 224, 0.08); border-left-color: #D4A574; }
.theme-dark .chapter-body a { color: #E8734A; }

/* ========== MOBI/AZW3 不支持页面 ========== */
.unsupported-wrap {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.unsupported-card {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 64rpx 48rpx;
  text-align: center;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.08);
}

.theme-green .unsupported-card { background: #FFFFFF; }
.theme-dark .unsupported-card { background: #2A2A44; }

.unsupported-icon {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 32rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1E88E5, #42A5F5);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
}

.unsupported-icon .icon {
  transform: scale(2);
}

.unsupported-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 16rpx;
}

.theme-dark .unsupported-title { color: #fff; }

.unsupported-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.7;
  margin-bottom: 40rpx;
}

.theme-dark .unsupported-desc { color: #bbb; }

.unsupported-info {
  background: rgba(107, 66, 38, 0.05);
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  text-align: left;
}

.theme-dark .unsupported-info { background: rgba(255, 255, 255, 0.05); }

.info-row {
  display: flex;
  padding: 12rpx 0;
  font-size: 26rpx;
}

.info-label {
  flex-shrink: 0;
  color: #999;
  width: 120rpx;
}

.theme-dark .info-label { color: #888; }

.info-value {
  flex: 1;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.theme-dark .info-value { color: #ddd; }

/* 底部工具栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0,0,0,0.7);
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 200;
}

.tool-row {
  display: flex;
  align-items: center;
  justify-content: center;
}

.page-info {
  color: #fff;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}

.actions {
  display: flex;
  justify-content: space-around;
}

.tool-btn {
  color: rgba(255,255,255,0.8);
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.tool-btn .icon {
  color: rgba(255,255,255,0.8);
}

.tool-btn.active {
  color: #E8734A;
}

.tool-btn.active .icon {
  color: #E8734A;
}

/* 目录 */
.toc-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 300;
}

.toc-panel {
  position: fixed;
  top: 0;
  right: -70%;
  width: 70%;
  height: 100vh;
  background: #fff;
  z-index: 301;
  transition: right 0.3s ease;
  display: flex;
  flex-direction: column;
}

.toc-panel.show { right: 0; }

.toc-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 24rpx 20rpx;
  border-bottom: 1rpx solid #eee;
}

.toc-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.toc-close {
  padding: 8rpx;
  color: #999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.toc-list {
  flex: 1;
  padding: 16rpx 0;
}

.toc-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.toc-item:active { background: #f5f0eb; }

.toc-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.toc-page {
  font-size: 24rpx;
  color: #999;
  margin-left: 16rpx;
}

/* 主题 */
.theme-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 300;
}

.theme-panel {
  position: fixed;
  bottom: -400rpx;
  left: 0; right: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 301;
  transition: bottom 0.3s ease;
}

.theme-panel.show { bottom: 0; }

.theme-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 32rpx;
}

.theme-options {
  display: flex;
  justify-content: space-around;
}

.theme-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: #666;
}

.theme-option.selected { color: #6B4226; font-weight: 600; }

.theme-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.theme-option.selected .theme-circle {
  box-shadow: 0 0 0 4rpx #6B4226;
}

/* 笔记弹窗 */
.note-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 300;
}

.note-dialog {
  position: fixed;
  bottom: 0;
  left: 0; right: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  z-index: 301;
  transition: transform 0.3s ease;
  transform: translateY(100%);
  max-height: 80vh;
  overflow-y: auto;
}

.note-dialog.show { transform: translateY(0); }

.note-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.note-title { font-size: 32rpx; font-weight: 600; color: #333; }
.note-close {
  padding: 8rpx;
  color: #999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.note-input {
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}

.note-content { min-height: 200rpx; }

.note-type {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.type-btn {
  padding: 12rpx 32rpx;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666;
}

.type-btn.active {
  background: #6B4226;
  color: #fff;
  border-color: #6B4226;
}

.note-submit {
  width: 100% !important;
  margin: 8rpx 0 0 0 !important;
  padding: 24rpx 0;
  box-sizing: border-box;
}
