.reader-page {
  min-height: 100vh;
  position: relative;
  background-color: #FFFFFF;
}

page {
  background-color: #FFFFFF;
}

/* 主题样式覆盖 */
.reader-page.theme-white {
  --bg-color: #FFFFFF;
  --text-color: #333333;
  background-color: #FFFFFF;
}

.reader-page.theme-green {
  --bg-color: #EBF9ED;
  --text-color: #2D4A2D;
  background-color: #EBF9ED;
}

.reader-page.theme-sepia {
  --bg-color: #F5F0EB;
  --text-color: #5D4037;
  background-color: #F5F0EB;
}

.reader-page.theme-dark {
  --bg-color: #1A1A2E;
  --text-color: #E0E0E0;
  background-color: #1A1A2E;
}

/* 顶部栏 */
.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  padding-top: 44rpx;
  background: rgba(0,0,0,0.7);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 24rpx;
  padding-right: 24rpx;
  z-index: 200;
  color: #fff;
}

.bar-left, .bar-right {
  padding: 12rpx 20rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
}

.bar-left .icon {
  color: #fff;
}

.bar-title {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 0 20rpx;
}

/* 滚动阅读 */
.scroll-reader {
  height: 100vh;
  width: 100%;
}

.page-image-wrap {
  width: 100%;
  position: relative;
}

.page-image {
  width: 100%;
  display: block;
}

.skeleton-page {
  width: 100%;
  min-height: 800rpx;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  background: var(--bg-color, #fff);
}

.skeleton-header {
  width: 60%;
  height: 48rpx;
  background: linear-gradient(90deg, #e8e8e8 25%, #f5f5f5 50%, #e8e8e8 75%);
  background-size: 400% 100%;
  border-radius: 8rpx;
  margin-bottom: 40rpx;
  animation: skeletonShimmer 1.4s ease infinite;
}

.skeleton-line {
  height: 24rpx;
  background: linear-gradient(90deg, #e8e8e8 25%, #f5f5f5 50%, #e8e8e8 75%);
  background-size: 400% 100%;
  border-radius: 6rpx;
  margin-bottom: 24rpx;
  animation: skeletonShimmer 1.4s ease infinite;
}

.skeleton-line-1 { width: 100%; }
.skeleton-line-2 { width: 95%; }
.skeleton-line-3 { width: 90%; }
.skeleton-line-4 { width: 98%; }
.skeleton-line-5 { width: 85%; }
.skeleton-line-6 { width: 92%; }
.skeleton-line-7 { width: 88%; }
.skeleton-line-8 { width: 70%; }

.skeleton-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-top: 60rpx;
  padding: 20rpx;
}

.skeleton-loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #6B4226;
  border-radius: 50%;
  animation: skeletonSpin 0.8s linear infinite;
}

.skeleton-loading-text {
  font-size: 26rpx;
  color: #999;
}

@keyframes skeletonShimmer {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

@keyframes skeletonSpin {
  to { transform: rotate(360deg); }
}

.theme-dark .skeleton-header,
.theme-dark .skeleton-line {
  background: linear-gradient(90deg, #2a2a40 25%, #3a3a55 50%, #2a2a40 75%);
  background-size: 400% 100%;
}

.theme-dark .skeleton-loading-text {
  color: #888;
}

.theme-dark .skeleton-loading-spinner {
  border-color: #3a3a55;
  border-top-color: #a0a0c0;
}

.network-status-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 150;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  padding-top: calc(12rpx + env(safe-area-inset-top));
}

.network-status-bar.network-weak {
  background: linear-gradient(90deg, #FFF8E1, #FFECB3);
  color: #F57C00;
}

.network-status-bar.network-offline {
  background: linear-gradient(90deg, #FFEBEE, #FFCDD2);
  color: #D32F2F;
}

.network-icon {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.network-icon-weak {
  background: #FF9800;
  position: relative;
}

.network-icon-weak::after {
  content: '!';
  color: #fff;
  font-size: 20rpx;
  font-weight: bold;
  line-height: 28rpx;
}

.network-icon-offline {
  background: #F44336;
  position: relative;
}

.network-icon-offline::after {
  content: '×';
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
  line-height: 26rpx;
}

/* 护眼模式 - 用真实遮罩层覆盖图片，统一绿色背景 */
/* 遮罩 rgba(199,237,204,0.35) 盖在白底上混合色约为 #EBF9ED */
.theme-green .page-image-wrap {
  position: relative;
  background-color: #EBF9ED;
}

.green-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(199, 237, 204, 0.35);
  pointer-events: none;
}

/* 羊皮纸 - 温暖棕色调滤镜 */
.sepia-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(212, 165, 116, 0.2);
  pointer-events: none;
}

.theme-green .scroll-reader,
.theme-green .swipe-reader,
.theme-green .swiper-page-scroll {
  background-color: #EBF9ED !important;
}

.theme-green .load-more,
.theme-green .load-end {
  color: #2D4A2D;
}

/* 羊皮纸主题 - 图片模式 */
.theme-sepia .page-image-wrap {
  background-color: #F5F0EB;
}

.theme-sepia .page-image {
  filter: sepia(30%) contrast(95%) brightness(98%);
}

.theme-sepia .scroll-reader,
.theme-sepia .swipe-reader,
.theme-sepia .swiper-page-scroll {
  background-color: #F5F0EB !important;
}

.theme-sepia .load-more,
.theme-sepia .load-end {
  color: #5D4037;
}

/* 夜间模式 - 反色+降低亮度 */
.theme-dark .page-image-wrap {
  background-color: #1A1A2E;
}

.theme-dark .page-image {
  filter: invert(90%) hue-rotate(180deg) brightness(90%) contrast(90%);
}

.theme-dark .scroll-reader,
.theme-dark .swipe-reader,
.theme-dark .swiper-page-scroll {
  background-color: #1A1A2E !important;
}

.theme-dark .load-more,
.theme-dark .load-end {
  color: #E0E0E0;
}

.load-more {
  text-align: center;
  padding: 40rpx;
  color: #6B4226;
  font-size: 28rpx;
}

.load-more:active {
  opacity: 0.7;
}

.load-end {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 26rpx;
}

/* 翻页阅读 */
.swipe-reader {
  height: 100vh;
  width: 100%;
}

.swiper-page-scroll {
  height: 100vh;
}

/* ========== HTML 流渲染 (EPUB) ========== */
.html-reader {
  padding: 0;
}

.chapter-wrap {
  width: 100%;
  padding: 20rpx 0 40rpx;
  box-sizing: border-box;
}

.chapter-title-bar {
  padding: 40rpx 40rpx 20rpx;
  border-bottom: 2rpx solid rgba(107, 66, 38, 0.15);
  margin-bottom: 24rpx;
}

.chapter-title-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  line-height: 1.5;
}

.chapter-body {
  padding: 0 32rpx;
  font-size: 30rpx;
  line-height: 1.9;
  color: #333;
  word-wrap: break-word;
  word-break: break-all;
}

/* rich-text 主题样式 */
.rich-text-white {
  color: #333333;
}

.rich-text-green {
  color: #2D4A2D;
}

.rich-text-sepia {
  color: #5D4037;
}

.rich-text-dark {
  color: #E0E0E0;
}

/* ========== 字号 & 行间距样式 ========== */
.font-size-xs .chapter-body,
.font-size-xs .chapter-body p,
.font-size-xs .chapter-body div,
.font-size-xs .chapter-body span {
  font-size: 24rpx !important;
}
.font-size-sm .chapter-body,
.font-size-sm .chapter-body p,
.font-size-sm .chapter-body div,
.font-size-sm .chapter-body span {
  font-size: 28rpx !important;
}
.font-size-md .chapter-body,
.font-size-md .chapter-body p,
.font-size-md .chapter-body div,
.font-size-md .chapter-body span {
  font-size: 32rpx !important;
}
.font-size-lg .chapter-body,
.font-size-lg .chapter-body p,
.font-size-lg .chapter-body div,
.font-size-lg .chapter-body span {
  font-size: 36rpx !important;
}
.font-size-xl .chapter-body,
.font-size-xl .chapter-body p,
.font-size-xl .chapter-body div,
.font-size-xl .chapter-body span {
  font-size: 42rpx !important;
}

/* 行间距 */
.line-height-tight .chapter-body,
.line-height-tight .chapter-body p,
.line-height-tight .chapter-body div,
.line-height-tight .chapter-body span {
  line-height: 1.5 !important;
}
.line-height-normal .chapter-body,
.line-height-normal .chapter-body p,
.line-height-normal .chapter-body div,
.line-height-normal .chapter-body span {
  line-height: 1.8 !important;
}
.line-height-loose .chapter-body,
.line-height-loose .chapter-body p,
.line-height-loose .chapter-body div,
.line-height-loose .chapter-body span {
  line-height: 2.1 !important;
}
.line-height-very-loose .chapter-body,
.line-height-very-loose .chapter-body p,
.line-height-very-loose .chapter-body div,
.line-height-very-loose .chapter-body span {
  line-height: 2.4 !important;
}

/* 主题覆盖 rich-text 内部常见元素 */
.html-reader .chapter-body p,
.html-reader .chapter-body div,
.html-reader .chapter-body span {
  line-height: 1.9 !important;
}

.html-reader .chapter-body img {
  max-width: 100% !important;
  height: auto !important;
  display: block;
  margin: 20rpx auto;
  border-radius: 8rpx;
}

.html-reader .chapter-body h1,
.html-reader .chapter-body h2,
.html-reader .chapter-body h3 {
  margin: 32rpx 0 20rpx;
  font-weight: 700;
  line-height: 1.4;
}

.html-reader .chapter-body h1 { font-size: 40rpx; }
.html-reader .chapter-body h2 { font-size: 34rpx; }
.html-reader .chapter-body h3 { font-size: 32rpx; }

.html-reader .chapter-body blockquote {
  margin: 24rpx 0;
  padding: 20rpx 24rpx;
  border-left: 6rpx solid #D4A574;
  background: rgba(212, 165, 116, 0.1);
  border-radius: 0 8rpx 8rpx 0;
  font-style: italic;
}

.html-reader .chapter-body hr {
  border: none;
  height: 2rpx;
  background: rgba(107, 66, 38, 0.2);
  margin: 32rpx 0;
}

.html-reader .chapter-body ul,
.html-reader .chapter-body ol {
  padding-left: 48rpx;
  margin: 16rpx 0;
}

.html-reader .chapter-body li {
  margin: 12rpx 0;
}

.html-reader .chapter-body a {
  color: #6B4226;
  text-decoration: none;
}

/* 主题适配 */
.theme-green .chapter-title-text { color: #2D4A2D; }
.theme-green .chapter-body { color: #2D4A2D; }
.theme-green .chapter-title-bar { border-bottom-color: rgba(45, 74, 45, 0.2); }
.theme-green blockquote { background: rgba(45, 74, 45, 0.08); border-left-color: #67C23A; }

.theme-sepia .chapter-title-text { color: #5D4037; }
.theme-sepia .chapter-body { color: #5D4037; }
.theme-sepia .chapter-title-bar { border-bottom-color: rgba(93, 64, 55, 0.18); }
.theme-sepia blockquote { background: rgba(212, 165, 116, 0.15); border-left-color: #8D6E63; }
.theme-sepia .chapter-body a { color: #6B4226; }
.theme-sepia .html-reader .search-highlight,
.theme-sepia .chapter-body .search-highlight {
  background-color: #FFE0B2 !important;
  color: #5D4037 !important;
}

.theme-dark .chapter-title-text { color: #E0E0E0; }
.theme-dark .chapter-body { color: #E0E0E0; }
.theme-dark .chapter-title-bar { border-bottom-color: rgba(224, 224, 224, 0.15); }
.theme-dark blockquote { background: rgba(224, 224, 224, 0.08); border-left-color: #D4A574; }
.theme-dark .chapter-body a { color: #E8734A; }

/* ========== MOBI/AZW3 不支持页面 ========== */
.unsupported-wrap {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.unsupported-card {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 64rpx 48rpx;
  text-align: center;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.08);
}

.theme-green .unsupported-card { background: #FFFFFF; }
.theme-sepia .unsupported-card { background: #FAF6F1; }
.theme-dark .unsupported-card { background: #2A2A44; }

.unsupported-icon {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 32rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1E88E5, #42A5F5);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
}

.unsupported-icon .icon {
  transform: scale(2);
}

.unsupported-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 16rpx;
}

.theme-dark .unsupported-title { color: #fff; }

.unsupported-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.7;
  margin-bottom: 40rpx;
}

.theme-dark .unsupported-desc { color: #bbb; }

.unsupported-info {
  background: rgba(107, 66, 38, 0.05);
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  text-align: left;
}

.theme-dark .unsupported-info { background: rgba(255, 255, 255, 0.05); }

.info-row {
  display: flex;
  padding: 12rpx 0;
  font-size: 26rpx;
}

.info-label {
  flex-shrink: 0;
  color: #999;
  width: 120rpx;
}

.theme-dark .info-label { color: #888; }

.info-value {
  flex: 1;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.theme-dark .info-value { color: #ddd; }

/* 底部工具栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0,0,0,0.7);
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 200;
}

.tool-row {
  display: flex;
  align-items: center;
  justify-content: center;
}

.page-info {
  color: #fff;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}

.actions {
  display: flex;
  justify-content: space-around;
}

.tool-btn {
  color: rgba(255,255,255,0.8);
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.tool-btn .icon {
  color: rgba(255,255,255,0.8);
}

.tool-btn.active {
  color: #E8734A;
}

.tool-btn.active .icon {
  color: #E8734A;
}

/* 目录 */
.toc-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 300;
}

.toc-panel {
  position: fixed;
  top: 0;
  right: -70%;
  width: 70%;
  height: 100vh;
  background: #fff;
  z-index: 301;
  transition: right 0.3s ease;
  display: flex;
  flex-direction: column;
}

.toc-panel.show { right: 0; }

.toc-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 24rpx 20rpx;
  border-bottom: 1rpx solid #eee;
}

.toc-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.toc-close {
  padding: 8rpx;
  color: #999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.toc-list {
  flex: 1;
  padding: 16rpx 0;
}

.toc-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.toc-item:active { background: #f5f0eb; }

.toc-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.toc-page {
  font-size: 24rpx;
  color: #999;
  margin-left: 16rpx;
}

/* 主题 */
.theme-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 300;
}

.theme-panel {
  position: fixed;
  bottom: -400rpx;
  left: 0; right: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 301;
  transition: bottom 0.3s ease;
}

.theme-panel.show { bottom: 0; }

.theme-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 32rpx;
}

.theme-options {
  display: flex;
  justify-content: space-around;
}

.theme-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: #666;
}

.theme-option.selected { color: #6B4226; font-weight: 600; }

.theme-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.theme-option.selected .theme-circle {
  box-shadow: 0 0 0 4rpx #6B4226;
}

/* 跟随系统深色模式 & 屏幕常亮 选项行 */
.follow-system-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 32rpx;
  padding: 20rpx 8rpx;
  border-top: 1rpx solid #f0f0f0;
}

.follow-system-row .option-label {
  font-size: 28rpx;
  color: #333;
}

/* ========== 设置面板样式 ========== */
.settings-panel {
  /* 复用 theme-panel 基础样式 */
}

.settings-section {
  margin-bottom: 32rpx;
}

.settings-section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 20rpx;
}

/* 字号设置 */
.font-size-options {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.font-size-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #F5F0EB;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.font-size-btn:active {
  background: #E8DCC8;
}

.font-size-icon {
  font-size: 28rpx;
  font-weight: 600;
  color: #6B4226;
}

.font-size-preset-row {
  flex: 1;
  display: flex;
  gap: 12rpx;
}

.font-size-preset {
  flex: 1;
  padding: 16rpx 0;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  text-align: center;
  font-size: 24rpx;
  color: #666;
  background: #fff;
}

.font-size-preset.selected {
  border-color: #6B4226;
  color: #6B4226;
  background: #FAF6F1;
  font-weight: 500;
}

.font-size-preset:active {
  opacity: 0.8;
}

/* 行间距设置 */
.line-height-options {
  display: flex;
  gap: 12rpx;
}

.line-height-option {
  flex: 1;
  padding: 20rpx 0;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  text-align: center;
  font-size: 26rpx;
  color: #666;
  background: #fff;
}

.line-height-option.selected {
  border-color: #6B4226;
  color: #6B4226;
  background: #FAF6F1;
  font-weight: 500;
}

.line-height-option:active {
  opacity: 0.8;
}

/* ========== 图标 CSS ========== */
/* 字号缩小图标 */
.icon-font-small {
  width: 32rpx;
  height: 32rpx;
  position: relative;
}
.icon-font-small::before {
  content: 'A';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 24rpx;
  font-weight: 600;
  font-family: Georgia, serif;
}

/* 字号放大图标 */
.icon-font-large {
  width: 32rpx;
  height: 32rpx;
  position: relative;
}
.icon-font-large::before {
  content: 'A';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 32rpx;
  font-weight: 600;
  font-family: Georgia, serif;
}

/* 设置图标（齿轮） */
.icon-settings {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  position: relative;
}
.icon-settings::before {
  content: '';
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}
.icon-settings::after {
  content: '';
  position: absolute;
  width: 4rpx;
  height: 6rpx;
  background: currentColor;
  top: -5rpx;
  left: 50%;
  transform: translateX(-50%);
  box-shadow:
    0 42rpx 0 currentColor,
    -16rpx 8rpx 0 currentColor,
    16rpx 8rpx 0 currentColor,
    -16rpx 32rpx 0 currentColor,
    16rpx 32rpx 0 currentColor;
}

/* 笔记弹窗 */
.note-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 300;
}

.note-dialog {
  position: fixed;
  bottom: 0;
  left: 0; right: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  z-index: 301;
  transition: transform 0.3s ease;
  transform: translateY(100%);
  max-height: 80vh;
  overflow-y: auto;
}

.note-dialog.show { transform: translateY(0); }

.note-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.note-title { font-size: 32rpx; font-weight: 600; color: #333; }
.note-close {
  padding: 8rpx;
  color: #999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.note-input {
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}

.note-content { min-height: 200rpx; }

.note-type {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.type-btn {
  padding: 12rpx 32rpx;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666;
}

.type-btn.active {
  background: #6B4226;
  color: #fff;
  border-color: #6B4226;
}

.form-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
  margin-top: 8rpx;
}

.form-input {
  width: 100%;
  padding: 20rpx;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
  background: #fff;
}

.note-options {
  margin-top: 8rpx;
}

.option-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.option-row:last-child {
  border-bottom: none;
}

.option-label {
  font-size: 28rpx;
  color: #333;
}

.switch {
  width: 80rpx;
  height: 44rpx;
  background: #ddd;
  border-radius: 22rpx;
  position: relative;
  transition: background 0.3s;
}

.switch.on {
  background: #6B4226;
}

.switch-dot {
  width: 36rpx;
  height: 36rpx;
  background: #fff;
  border-radius: 50%;
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  transition: left 0.3s;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.2);
}

.switch.on .switch-dot {
  left: 40rpx;
}

.color-options {
  display: flex;
  gap: 20rpx;
}

.color-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 4rpx solid transparent;
  box-sizing: border-box;
}

.color-dot.selected {
  border-color: #6B4226;
  transform: scale(1.1);
}

.note-submit {
  width: 100% !important;
  margin: 8rpx 0 0 0 !important;
  padding: 24rpx 0;
  box-sizing: border-box;
}

/* ========== 书签相关样式 ========== */

/* 顶部栏右侧按钮组 */
.bar-right-btns {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.bar-btn {
  padding: 12rpx 20rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  color: rgba(255,255,255,0.9);
  border-radius: 8rpx;
}

.bar-btn.active {
  color: #E8734A;
}

.bar-btn .icon {
  color: inherit;
  font-size: 32rpx;
}

/* 书签图标（填充状态） */
.icon-bookmark.filled,
.icon-bookmark-filled {
  color: #E8734A !important;
}

/* 页面上的书签标记 */
.bookmark-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 56rpx;
  height: 56rpx;
  background: rgba(255, 107, 53, 0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.15);
  z-index: 10;
}

.bookmark-badge .icon {
  color: #fff !important;
  font-size: 28rpx;
  transform: scale(1.1);
}

/* 书签侧栏 */
.bookmark-panel {
  /* 复用 toc-panel 样式，独立扩展 */
}

.bookmark-tabs {
  display: flex;
  border-bottom: 1rpx solid #eee;
  background: #fafafa;
}

.bookmark-tab {
  flex: 1;
  padding: 24rpx 16rpx;
  text-align: center;
  font-size: 26rpx;
  color: #666;
  position: relative;
}

.bookmark-tab.active {
  color: #6B4226;
  font-weight: 600;
}

.bookmark-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: #6B4226;
  border-radius: 2rpx;
}

.bookmark-list {
  padding: 0;
}

.bookmark-item {
  border-bottom: 1rpx solid #f5f5f5;
  background: #fff;
}

.bookmark-item:active {
  background: #faf8f6;
}

.bookmark-main {
  display: flex;
  align-items: center;
  padding: 24rpx;
  gap: 16rpx;
}

.bookmark-info {
  flex: 1;
  min-width: 0;
}

.bookmark-chapter-tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  background: linear-gradient(135deg, #FF9966, #FF5E62);
  color: #fff;
  font-size: 22rpx;
  border-radius: 6rpx;
  margin-bottom: 8rpx;
}

.bookmark-title {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  line-height: 1.4;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bookmark-meta {
  display: block;
  font-size: 22rpx;
  color: #999;
  line-height: 1.4;
  margin-bottom: 6rpx;
}

.bookmark-remark {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
  margin-top: 8rpx;
  padding: 12rpx 16rpx;
  background: #f8f6f4;
  border-radius: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.icon-arrow-right {
  color: #ccc;
  font-size: 28rpx;
  flex-shrink: 0;
}

.bookmark-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  padding: 12rpx 24rpx 20rpx;
  background: #fafafa;
  border-top: 1rpx solid #f0f0f0;
}

.bookmark-action-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #fff;
  border: 1rpx solid #eee;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #666;
}

.bookmark-action-btn:active {
  background: #f0f0f0;
}

.bookmark-action-btn .icon {
  font-size: 24rpx;
  color: #666;
}

.bookmark-action-btn.edit .icon {
  color: #4A90D9;
}

.bookmark-action-btn.delete .icon {
  color: #E74C3C;
}

.empty-hint {
  display: block;
  font-size: 24rpx;
  color: #bbb;
  margin-top: 12rpx;
  line-height: 1.6;
  padding: 0 32rpx;
}

/* 书签弹窗 */
.bookmark-dialog {
  /* 复用 note-dialog 样式 */
}

.form-label {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 12rpx;
  margin-top: 8rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
  background: #fff;
}

.bookmark-remark-input {
  min-height: 160rpx !important;
  margin-bottom: 24rpx;
}

/* 复选框 */
.form-checkbox-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 16rpx 12rpx;
  background: #fafafa;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
}

.form-checkbox-row:active {
  background: #f5f2ef;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid #ddd;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 4rpx;
  background: #fff;
}

.checkbox.checked {
  background: #6B4226;
  border-color: #6B4226;
}

.checkbox.checked .icon {
  color: #fff !important;
  font-size: 24rpx;
}

.checkbox-label {
  flex: 1;
  min-width: 0;
}

.checkbox-title {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.checkbox-desc {
  display: block;
  font-size: 22rpx;
  color: #999;
  line-height: 1.5;
}

/* 工具栏按钮组，因为新增了按钮需要适配 */
.bottom-bar .actions {
  flex-wrap: wrap;
  gap: 8rpx 0;
}

.bottom-bar .tool-btn {
  min-width: 14%;
  padding: 10rpx 16rpx;
  font-size: 22rpx;
}

.bottom-bar .tool-btn .icon {
  font-size: 32rpx;
}

/* 主题适配 */
.theme-dark .bookmark-tabs {
  background: #2A2A44;
  border-bottom-color: rgba(255,255,255,0.1);
}

.theme-dark .bookmark-tab {
  color: #aaa;
}

.theme-dark .bookmark-tab.active {
  color: #E8734A;
}

.theme-dark .bookmark-item {
  background: #1A1A2E;
  border-bottom-color: rgba(255,255,255,0.08);
}

.theme-dark .bookmark-item:active {
  background: #252540;
}

.theme-dark .bookmark-title {
  color: #E0E0E0;
}

.theme-dark .bookmark-meta {
  color: #888;
}

.theme-dark .bookmark-remark {
  background: rgba(255,255,255,0.05);
  color: #bbb;
}

.theme-dark .bookmark-actions {
  background: rgba(255,255,255,0.03);
  border-top-color: rgba(255,255,255,0.08);
}

.theme-dark .bookmark-action-btn {
  background: #2A2A44;
  border-color: rgba(255,255,255,0.15);
}

.theme-dark .bookmark-action-btn:active {
  background: #353555;
}

.theme-dark .bookmark-action-btn .icon {
  color: #aaa;
}

.theme-dark .form-input {
  background: #2A2A44;
  border-color: rgba(255,255,255,0.15);
  color: #E0E0E0;
}

.theme-dark .form-label {
  color: #E0E0E0;
}

.theme-dark .form-checkbox-row {
  background: rgba(255,255,255,0.05);
}

.theme-dark .checkbox {
  background: #2A2A44;
  border-color: rgba(255,255,255,0.2);
}

/* 深色模式 - 主题面板 / 设置面板 */
.theme-dark .theme-panel,
.theme-dark .settings-panel,
.theme-dark .note-dialog {
  background: #252542;
}

.theme-dark .theme-title,
.theme-dark .note-title,
.theme-dark .settings-section-title {
  color: #E0E0E0;
}

.theme-dark .theme-option,
.theme-dark .type-btn {
  color: #aaa;
}

.theme-dark .theme-option.selected {
  color: #E8734A;
}

.theme-dark .theme-option.selected .theme-circle {
  box-shadow: 0 0 0 4rpx #E8734A;
}

.theme-dark .follow-system-row {
  border-top-color: rgba(255,255,255,0.08);
}

.theme-dark .follow-system-row .option-label {
  color: #E0E0E0;
}

.theme-dark .font-size-btn {
  background: #3A3A5C;
}

.theme-dark .font-size-btn:active {
  background: #4A4A70;
}

.theme-dark .font-size-icon {
  color: #E8734A;
}

.theme-dark .font-size-preset,
.theme-dark .line-height-option {
  background: #2A2A44;
  border-color: rgba(255,255,255,0.15);
  color: #aaa;
}

.theme-dark .font-size-preset.selected,
.theme-dark .line-height-option.selected {
  background: rgba(232, 115, 74, 0.15);
  border-color: #E8734A;
  color: #E8734A;
}

/* 底部工具栏按钮数量增加后的适配 */
.bottom-bar .actions {
  flex-wrap: wrap;
  gap: 8rpx 0;
  row-gap: 4rpx;
}

.bottom-bar .tool-btn {
  min-width: 13%;
  padding: 8rpx 10rpx;
  font-size: 20rpx;
}

.bottom-bar .tool-btn .icon {
  font-size: 28rpx;
  width: 36rpx;
  height: 36rpx;
}

/* 羊皮纸主题 - 面板/对话框适配 */
.theme-sepia .theme-panel,
.theme-sepia .settings-panel,
.theme-sepia .note-dialog {
  background: #FAF6F1;
}

.theme-sepia .theme-title,
.theme-sepia .note-title,
.theme-sepia .settings-section-title,
.theme-sepia .theme-option.selected,
.theme-sepia .follow-system-row .option-label {
  color: #5D4037;
}

.theme-sepia .theme-option,
.theme-sepia .type-btn {
  color: #8D6E63;
}

.theme-sepia .theme-option.selected .theme-circle {
  box-shadow: 0 0 0 4rpx #6B4226;
}

.theme-sepia .follow-system-row {
  border-top-color: rgba(93, 64, 55, 0.1);
}

.theme-sepia .font-size-btn {
  background: #EFE6DA;
}

.theme-sepia .font-size-btn:active {
  background: #E8DCC8;
}

.theme-sepia .font-size-icon {
  color: #6B4226;
}

.theme-sepia .font-size-preset,
.theme-sepia .line-height-option {
  background: #fff;
  border-color: #E8DCC8;
  color: #8D6E63;
}

.theme-sepia .font-size-preset.selected,
.theme-sepia .line-height-option.selected {
  background: #F5F0EB;
  border-color: #6B4226;
  color: #6B4226;
}

.theme-dark .checkbox-label .checkbox-title {
  color: #E0E0E0;
}

.theme-dark .checkbox-label .checkbox-desc {
  color: #888;
}

/* ========== 搜索高亮样式 ========== */
.html-reader .search-highlight,
.chapter-body .search-highlight {
  background-color: #FFF3CD !important;
  color: #E74C3C !important;
  font-weight: 600;
  padding: 2rpx 6rpx;
  border-radius: 4rpx;
  box-shadow: 0 0 0 2rpx rgba(255, 193, 7, 0.4);
}

.theme-green .html-reader .search-highlight,
.theme-green .chapter-body .search-highlight {
  background-color: #FFEB99 !important;
  color: #C0392B !important;
}

.theme-dark .html-reader .search-highlight,
.theme-dark .chapter-body .search-highlight {
  background-color: #5D4E37 !important;
  color: #FFD54F !important;
  box-shadow: 0 0 0 2rpx rgba(255, 213, 79, 0.3);
}

/* PDF图片模式下，当前匹配页标记 */
.page-image-wrap.search-match-page {
  box-shadow: 0 0 0 6rpx rgba(255, 193, 7, 0.6);
  position: relative;
}

.page-image-wrap.search-match-page::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border: 4rpx solid #FFC107;
  z-index: 5;
  pointer-events: none;
  box-sizing: border-box;
}

.search-highlight-toast {
  position: fixed;
  top: 200rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(107, 66, 38, 0.9);
  color: #fff;
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  z-index: 999;
}
