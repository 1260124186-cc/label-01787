<view class="reader-page {{themeClass}}">
  <!-- 顶部栏 -->
  <view class="top-bar" wx:if="{{showUI}}">
    <view class="bar-left" bindtap="goBack">
      <view class="icon icon-back"></view>
    </view>
    <view class="bar-title">{{book.title}}</view>
    <view class="bar-right-btns">
      <view class="bar-btn {{currentBookmarked ? 'active' : ''}}" bindtap="addBookmarkFromToolbar">
        <view class="icon icon-bookmark {{currentBookmarked ? 'filled' : ''}}"></view>
      </view>
      <view class="bar-btn" bindtap="toggleTocPanel">
        <text>目录</text>
      </view>
    </view>
  </view>

  <!-- MOBI/AZW3 不支持提示 -->
  <view wx:if="{{streamType === 'unsupported'}}" class="unsupported-wrap" style="background-color: {{bgColor}};">
    <view class="unsupported-card">
      <view class="unsupported-icon">
        <view class="icon icon-document"></view>
      </view>
      <text class="unsupported-title">暂不支持在线阅读</text>
      <text class="unsupported-desc">MOBI/AZW3 格式暂不支持在线阅读，建议转换为 EPUB 或 PDF 格式后上传</text>
      <view class="unsupported-info">
        <view class="info-row"><text class="info-label">书名：</text><text class="info-value">{{book.title}}</text></view>
        <view class="info-row"><text class="info-label">格式：</text><text class="info-value">{{(book.bookFormat || 'mobi').toUpperCase()}}</text></view>
        <view class="info-row"><text class="info-label">大小：</text><text class="info-value">{{book.fileSizeText}}</text></view>
      </view>
    </view>
  </view>

  <!-- ========== 图片流渲染 (PDF) ========== -->
  <!-- 滚动模式 -->
  <scroll-view wx:if="{{streamType === 'image' && readMode === 'scroll'}}" scroll-y class="scroll-reader"
    style="background-color: {{bgColor}};"
    bindtap="toggleUI"
    bindscroll="onScroll"
    bindscrolltolower="loadMorePages"
    lower-threshold="300">
    <view wx:for="{{loadedPages}}" wx:key="index" class="page-image-wrap" id="unit-{{index}}"
      bindlongpress="onPageLongPress">
      <image src="{{item}}" mode="widthFix" class="page-image" lazy-load show-menu-by-longpress="{{false}}" />
      <view class="green-overlay" wx:if="{{theme === 'green'}}"></view>
      <view class="bookmark-badge" wx:if="{{currentBookmarked && index === displayUnit - startUnitNum}}">
        <view class="icon icon-bookmark-filled"></view>
      </view>
    </view>
    <view class="load-more" wx:if="{{currentUnit < totalUnits}}" bindtap="loadMorePages">
      <text>{{loading ? '加载中...' : '加载更多'}}</text>
    </view>
    <view class="load-end" wx:if="{{currentUnit >= totalUnits}}">
      <text>已加载全部页面</text>
    </view>
  </scroll-view>

  <!-- 翻页模式 -->
  <swiper wx:if="{{streamType === 'image' && readMode === 'swipe'}}" class="swipe-reader" current="{{swiperIndex}}"
    bindchange="onSwiperChange" bindtap="toggleUI"
    style="background-color: {{bgColor}};">
    <swiper-item wx:for="{{loadedPages}}" wx:key="index">
      <scroll-view scroll-y class="swiper-page-scroll" style="background-color: {{bgColor}};">
        <view class="page-image-wrap" bindlongpress="onPageLongPress">
          <image src="{{item}}" mode="widthFix" class="page-image" show-menu-by-longpress="{{false}}" />
          <view class="green-overlay" wx:if="{{theme === 'green'}}"></view>
          <view class="bookmark-badge" wx:if="{{currentBookmarked && index === displayUnit - startUnitNum}}">
            <view class="icon icon-bookmark-filled"></view>
          </view>
        </view>
      </scroll-view>
    </swiper-item>
  </swiper>

  <!-- ========== HTML 流渲染 (EPUB) ========== -->
  <!-- 章节滚动模式 -->
  <scroll-view wx:if="{{streamType === 'html' && readMode === 'scroll'}}" scroll-y class="scroll-reader html-reader"
    style="background-color: {{bgColor}};"
    bindtap="toggleUI"
    bindscroll="onScrollHtml"
    bindscrolltolower="loadMoreChapters"
    lower-threshold="300">
    <view wx:for="{{loadedChapters}}" wx:key="chapterIndex" class="chapter-wrap" id="chapter-{{item.chapterIndex}}"
      bindlongpress="onPageLongPress">
      <view class="chapter-title-bar" wx:if="{{item.title}}">
        <text class="chapter-title-text">{{item.title}}</text>
      </view>
      <view class="chapter-body rich-text-{{theme}}">
        <rich-text nodes="{{item.html}}" space="nbsp"></rich-text>
      </view>
      <view class="bookmark-badge" wx:if="{{currentBookmarked && item.chapterIndex === displayUnit - 1}}">
        <view class="icon icon-bookmark-filled"></view>
      </view>
    </view>
    <view class="load-more" wx:if="{{currentUnit < totalUnits}}" bindtap="loadMoreChapters">
      <text>{{loading ? '加载中...' : '加载更多章节'}}</text>
    </view>
    <view class="load-end" wx:if="{{currentUnit >= totalUnits}}">
      <text>已加载全部章节</text>
    </view>
  </scroll-view>

  <!-- 章节翻页模式 -->
  <swiper wx:if="{{streamType === 'html' && readMode === 'swipe'}}" class="swipe-reader" current="{{swiperIndex}}"
    bindchange="onSwiperChangeHtml" bindtap="toggleUI"
    style="background-color: {{bgColor}};">
    <swiper-item wx:for="{{loadedChapters}}" wx:key="chapterIndex">
      <scroll-view scroll-y class="swiper-page-scroll html-reader" style="background-color: {{bgColor}};"
        bindlongpress="onPageLongPress">
        <view class="chapter-title-bar" wx:if="{{item.title}}">
          <text class="chapter-title-text">{{item.title}}</text>
        </view>
        <view class="chapter-body rich-text-{{theme}}">
          <rich-text nodes="{{item.html}}" space="nbsp"></rich-text>
        </view>
        <view class="bookmark-badge" wx:if="{{currentBookmarked && item.chapterIndex === displayUnit - 1}}">
          <view class="icon icon-bookmark-filled"></view>
        </view>
      </scroll-view>
    </swiper-item>
  </swiper>

  <!-- 底部工具栏 -->
  <view class="bottom-bar" wx:if="{{showUI && streamType !== 'unsupported'}}">
    <view class="tool-row">
      <text class="page-info">{{displayUnit}} / {{totalUnits || '-'}} {{streamType === 'html' ? '章' : '页'}}</text>
    </view>
    <view class="tool-row actions">
      <view class="tool-btn {{readMode === 'scroll' ? 'active' : ''}}" bindtap="switchMode" data-mode="scroll">
        <view class="icon icon-scroll"></view>
        <text>滚动</text>
      </view>
      <view class="tool-btn {{readMode === 'swipe' ? 'active' : ''}}" bindtap="switchMode" data-mode="swipe">
        <view class="icon icon-swipe"></view>
        <text>翻页</text>
      </view>
      <view class="tool-btn" bindtap="showThemePicker">
        <view class="icon icon-palette"></view>
        <text>主题</text>
      </view>
      <view class="tool-btn {{currentBookmarked ? 'active' : ''}}" bindtap="addBookmarkFromToolbar">
        <view class="icon icon-bookmark {{currentBookmarked ? 'filled' : ''}}"></view>
        <text>书签</text>
      </view>
      <view class="tool-btn" bindtap="addNote">
        <view class="icon icon-note"></view>
        <text>笔记</text>
      </view>
      <view class="tool-btn" bindtap="toggleBookmarkPanel">
        <view class="icon icon-list"></view>
        <text>书签列表</text>
      </view>
      <view class="tool-btn" bindtap="openAiAssistant">
        <view class="icon icon-ai"></view>
        <text>AI助手</text>
      </view>
    </view>
  </view>

  <!-- 目录/书签侧栏遮罩 -->
  <view class="toc-mask" wx:if="{{showToc || showBookmark}}" bindtap="toggleTocPanel" catchtap="toggleBookmarkPanel"></view>

  <!-- 目录侧栏 -->
  <view class="toc-panel {{showToc ? 'show' : ''}}">
    <view class="toc-header">
      <text class="toc-title">目录</text>
      <view class="toc-close" bindtap="toggleTocPanel"><view class="icon icon-close"></view></view>
    </view>
    <scroll-view scroll-y class="toc-list">
      <block wx:if="{{streamType === 'html'}}">
        <view class="toc-item" wx:for="{{toc}}" wx:key="index" bindtap="jumpToChapter" data-index="{{item.chapterIndex}}">
          <text class="toc-text">{{item.title}}</text>
          <text class="toc-page">第{{(item.chapterIndex || 0) + 1}}章</text>
        </view>
      </block>
      <block wx:else>
        <view class="toc-item" wx:for="{{toc}}" wx:key="index" bindtap="jumpToPage" data-page="{{item.page}}">
          <text class="toc-text">{{item.title}}</text>
          <text class="toc-page">{{item.page}}{{item.isBookmark ? ' (锚点)' : ''}}</text>
        </view>
      </block>
      <view class="empty-state" wx:if="{{toc.length === 0}}">
        <text class="empty-text">暂无目录信息</text>
        <text class="empty-hint">可在书签列表中添加"章节锚点"代替目录导航</text>
      </view>
    </scroll-view>
  </view>

  <!-- 书签侧栏 -->
  <view class="toc-panel bookmark-panel {{showBookmark ? 'show' : ''}}">
    <view class="toc-header">
      <text class="toc-title">书签 / 章节锚点</text>
      <view class="toc-close" bindtap="toggleBookmarkPanel"><view class="icon icon-close"></view></view>
    </view>
    <view class="bookmark-tabs">
      <view class="bookmark-tab {{tocActiveTab === 'bookmark' ? 'active' : ''}}" bindtap="switchTocTab" data-tab="bookmark">
        <text>书签 ({{bookmarks.length}})</text>
      </view>
      <view class="bookmark-tab {{tocActiveTab === 'chapter' ? 'active' : ''}}" bindtap="switchTocTab" data-tab="chapter">
        <text>章节锚点 ({{chapterBookmarks.length}})</text>
      </view>
    </view>
    <scroll-view scroll-y class="toc-list bookmark-list">
      <block wx:if="{{tocActiveTab === 'bookmark'}}">
        <view class="bookmark-item" wx:for="{{bookmarks}}" wx:key="id" wx:for-index="idx">
          <view class="bookmark-main" bindtap="jumpToBookmark" data-bookmark="{{item}}">
            <view class="bookmark-info">
              <text class="bookmark-title">{{item.title || '未命名书签'}}</text>
              <text class="bookmark-meta">
                第{{item.pageNum}}{{item.unitType === 2 ? '章' : '页'}} · {{item.createdAt}}
              </text>
              <text class="bookmark-remark" wx:if="{{item.remark}}">{{item.remark}}</text>
            </view>
            <view class="icon icon-arrow-right"></view>
          </view>
          <view class="bookmark-actions">
            <view class="bookmark-action-btn" bindtap="moveBookmarkUp" data-index="{{idx}}" data-type="bookmark" wx:if="{{idx > 0}}">
              <view class="icon icon-up"></view>
            </view>
            <view class="bookmark-action-btn" bindtap="moveBookmarkDown" data-index="{{idx}}" data-type="bookmark" wx:if="{{idx < bookmarks.length - 1}}">
              <view class="icon icon-down"></view>
            </view>
            <view class="bookmark-action-btn edit" bindtap="editBookmark" data-id="{{item.id}}">
              <view class="icon icon-edit"></view>
            </view>
            <view class="bookmark-action-btn delete" bindtap="deleteBookmark" data-id="{{item.id}}">
              <view class="icon icon-trash"></view>
            </view>
          </view>
        </view>
        <view class="empty-state" wx:if="{{bookmarks.length === 0}}">
          <text class="empty-text">暂无书签</text>
          <text class="empty-hint">点击工具栏"书签"按钮或长按页面添加</text>
        </view>
      </block>
      <block wx:else>
        <view class="bookmark-item" wx:for="{{chapterBookmarks}}" wx:key="id" wx:for-index="idx">
          <view class="bookmark-main" bindtap="jumpToBookmark" data-bookmark="{{item}}">
            <view class="bookmark-info">
              <view class="bookmark-chapter-tag">章节锚点</view>
              <text class="bookmark-title">{{item.title || '未命名章节'}}</text>
              <text class="bookmark-meta">
                第{{item.pageNum}}{{item.unitType === 2 ? '章' : '页'}}
              </text>
              <text class="bookmark-remark" wx:if="{{item.remark}}">{{item.remark}}</text>
            </view>
            <view class="icon icon-arrow-right"></view>
          </view>
          <view class="bookmark-actions">
            <view class="bookmark-action-btn" bindtap="moveBookmarkUp" data-index="{{idx}}" data-type="chapter" wx:if="{{idx > 0}}">
              <view class="icon icon-up"></view>
            </view>
            <view class="bookmark-action-btn" bindtap="moveBookmarkDown" data-index="{{idx}}" data-type="chapter" wx:if="{{idx < chapterBookmarks.length - 1}}">
              <view class="icon icon-down"></view>
            </view>
            <view class="bookmark-action-btn edit" bindtap="editBookmark" data-id="{{item.id}}">
              <view class="icon icon-edit"></view>
            </view>
            <view class="bookmark-action-btn delete" bindtap="deleteBookmark" data-id="{{item.id}}">
              <view class="icon icon-trash"></view>
            </view>
          </view>
        </view>
        <view class="empty-state" wx:if="{{chapterBookmarks.length === 0}}">
          <text class="empty-text">暂无章节锚点</text>
          <text class="empty-hint">添加书签时勾选"设为章节锚点"，无目录的PDF可用来代替章节导航</text>
        </view>
      </block>
    </scroll-view>
  </view>

  <!-- 主题选择弹窗 -->
  <view class="theme-mask" wx:if="{{showTheme}}" bindtap="hideThemePicker"></view>
  <view class="theme-panel {{showTheme ? 'show' : ''}}">
    <text class="theme-title">阅读主题</text>
    <view class="theme-options">
      <view class="theme-option {{theme === 'white' ? 'selected' : ''}}" bindtap="changeTheme" data-theme="white">
        <view class="theme-circle" style="background: #FFFFFF; border: 2rpx solid #ddd;"></view>
        <text>白色</text>
      </view>
      <view class="theme-option {{theme === 'green' ? 'selected' : ''}}" bindtap="changeTheme" data-theme="green">
        <view class="theme-circle" style="background: #EBF9ED;"></view>
        <text>护眼绿</text>
      </view>
      <view class="theme-option {{theme === 'dark' ? 'selected' : ''}}" bindtap="changeTheme" data-theme="dark">
        <view class="theme-circle" style="background: #1A1A2E;"></view>
        <text>夜空黑</text>
      </view>
    </view>
  </view>

  <!-- 笔记弹窗 -->
  <view class="note-mask" wx:if="{{showNoteDialog}}" bindtap="hideNoteDialog"></view>
  <view class="note-dialog {{showNoteDialog ? 'show' : ''}}">
    <view class="note-header">
      <text class="note-title">添加笔记</text>
      <view class="note-close" bindtap="hideNoteDialog"><view class="icon icon-close"></view></view>
    </view>
    <view class="note-body">
      <textarea class="note-input" placeholder="请输入选中的文字（可选）" value="{{noteText}}"
        bindinput="onNoteTextInput" maxlength="500" />
      <textarea class="note-input note-content" placeholder="写下你的想法..." value="{{noteContent}}"
        bindinput="onNoteContentInput" maxlength="2000" />
      <view class="note-type">
        <view class="type-btn {{noteType === 1 ? 'active' : ''}}" bindtap="setNoteType" data-type="1">评语</view>
        <view class="type-btn {{noteType === 2 ? 'active' : ''}}" bindtap="setNoteType" data-type="2">笔记</view>
      </view>

      <view class="form-label">标签（用逗号分隔，如：复习,重点）</view>
      <input class="form-input" placeholder="输入标签，多个用逗号分隔" value="{{noteTags}}"
        bindinput="onNoteTagsInput" maxlength="200" />

      <view class="note-options">
        <view class="option-row">
          <text class="option-label">置顶</text>
          <view class="switch {{noteIsPinned ? 'on' : ''}}" bindtap="toggleNotePin">
            <view class="switch-dot"></view>
          </view>
        </view>

        <view class="option-row">
          <text class="option-label">标记颜色</text>
          <view class="color-options">
            <view class="color-dot {{noteColor === item.key ? 'selected' : ''}}"
              wx:for="{{colorOptions}}" wx:key="key"
              style="background: {{item.color}};"
              bindtap="selectNoteColor" data-color="{{item.key}}">
            </view>
          </view>
        </view>
      </view>
    </view>
    <button class="btn-primary note-submit" bindtap="submitNote">保存</button>
  </view>

  <!-- 书签编辑弹窗 -->
  <view class="note-mask" wx:if="{{showBookmarkDialog}}" bindtap="hideBookmarkDialog"></view>
  <view class="note-dialog bookmark-dialog {{showBookmarkDialog ? 'show' : ''}}">
    <view class="note-header">
      <text class="note-title">{{bookmarkEditMode ? '编辑书签' : '添加书签'}}</text>
      <view class="note-close" bindtap="hideBookmarkDialog"><view class="icon icon-close"></view></view>
    </view>
    <view class="note-body">
      <view class="form-label">书签名称</view>
      <input class="form-input" placeholder="请输入书签名称" value="{{bookmarkTitle}}"
        bindinput="onBookmarkTitleInput" maxlength="200" />
      <view class="form-label">备注说明（可选）</view>
      <textarea class="note-input bookmark-remark-input" placeholder="添加备注说明..." value="{{bookmarkRemark}}"
        bindinput="onBookmarkRemarkInput" maxlength="500" />
      <view class="form-checkbox-row" bindtap="toggleBookmarkIsChapter">
        <view class="checkbox {{bookmarkIsChapter ? 'checked' : ''}}">
          <view class="icon icon-check" wx:if="{{bookmarkIsChapter}}"></view>
        </view>
        <view class="checkbox-label">
          <text class="checkbox-title">设为章节锚点</text>
          <text class="checkbox-desc">无目录的PDF可用来代替章节导航</text>
        </view>
      </view>
    </view>
    <button class="btn-primary note-submit" bindtap="submitBookmark">
      {{bookmarkEditMode ? '保存修改' : '添加书签'}}
    </button>
  </view>
</view>
